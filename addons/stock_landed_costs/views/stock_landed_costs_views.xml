<erp>
  <record id="view_product_template_form_landed_costs" model="ir.ui.view">
    <field name="name">product.template.form.landed.costs</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.product_template_form_stock_buttons"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='logistics']" position="after">
        <group name="landed_costs" string="Landed Costs">
          <field name="landed_cost_ok"/>
          <field name="split_method_landed_cost" invisible="not landed_cost_ok"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_stock_landed_cost_line_list" model="ir.ui.view">
    <field name="name">stock.landed.cost.lines.list</field>
    <field name="model">stock.landed.cost.lines</field>
    <field name="arch" type="xml">
      <list>
        <field name="product_id"/>
        <field name="name"/>
        <field name="account_id"/>
        <field name="split_method"/>
        <field name="price_unit"/>
      </list>
    </field>
  </record>

  <record id="view_stock_landed_cost_line_form" model="ir.ui.view">
    <field name="name">stock.landed.cost.lines.form</field>
    <field name="model">stock.landed.cost.lines</field>
    <field name="arch" type="xml">
      <form string="Additional Cost Line">
        <sheet>
          <group>
            <group>
              <field name="product_id"/>
              <field name="name"/>
              <field name="account_id"/>
            </group>
            <group>
              <field name="split_method"/>
              <field name="price_unit"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_stock_valuation_adjustment_line_list" model="ir.ui.view">
    <field name="name">stock.valuation.adjustment.lines.list</field>
    <field name="model">stock.valuation.adjustment.lines</field>
    <field name="arch" type="xml">
      <list>
        <field name="cost_line_id"/>
        <field name="product_id"/>
        <field name="quantity"/>
        <field name="weight"/>
        <field name="volume"/>
        <field name="former_cost"/>
        <field name="additional_landed_cost"/>
        <field name="final_cost"/>
      </list>
    </field>
  </record>

  <record id="view_stock_valuation_adjustment_line_form" model="ir.ui.view">
    <field name="name">stock.valuation.adjustment.lines.form</field>
    <field name="model">stock.valuation.adjustment.lines</field>
    <field name="arch" type="xml">
      <form string="Valuation Adjustment">
        <sheet>
          <group>
            <group>
              <field name="cost_line_id" readonly="1"/>
              <field name="product_id" readonly="1"/>
              <field name="quantity" readonly="1"/>
              <field name="weight" readonly="1"/>
              <field name="volume" readonly="1"/>
            </group>
            <group>
              <field name="former_cost" readonly="1"/>
              <field name="additional_landed_cost" readonly="1"/>
              <field name="final_cost" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_stock_landed_cost_list" model="ir.ui.view">
    <field name="name">stock.landed.cost.list</field>
    <field name="model">stock.landed.cost</field>
    <field name="arch" type="xml">
      <list string="Landed Costs">
        <dashboard>
          <count name="draft" string="Draft" filter="filter_draft" color="warning"/>
          <count name="done" string="Posted" filter="filter_done" color="success"/>
        </dashboard>
        <field name="name"/>
        <field name="date"/>
        <field name="account_journal_id"/>
        <field name="amount_total"/>
        <field name="company_id"/>
        <field name="state" widget="badge" options="{'tone_warning': ['draft'], 'tone_success': ['done'], 'tone_muted': ['cancel']}"/>
      </list>
    </field>
  </record>

  <record id="view_stock_landed_cost_form" model="ir.ui.view">
    <field name="name">stock.landed.cost.form</field>
    <field name="model">stock.landed.cost</field>
    <field name="arch" type="xml">
      <form string="Landed Cost">
        <header>
          <button name="compute_landed_cost" type="object" string="Compute" invisible="state != 'draft'"/>
          <button name="button_validate" type="object" string="Validate" data-hotkey="v" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="button_cancel" type="object" string="Cancel" data-hotkey="x" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Posted" bg_color="bg-success" invisible="state != 'done'"/>
          <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancel'"/>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="date" readonly="state != 'draft'"/>
              <field name="target_model" readonly="state != 'draft'"/>
              <field name="picking_ids" widget="many2many_tags" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="account_journal_id" readonly="state != 'draft'"/>
              <field name="vendor_bill_id" readonly="state != 'draft'"/>
              <field name="account_move_id" readonly="1" invisible="not account_move_id"/>
              <field name="amount_total" readonly="1"/>
              <field name="company_id" readonly="state != 'draft'"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page name="additional_costs" string="Additional Costs">
              <field name="cost_lines" readonly="state != 'draft'"/>
              <group>
                <field name="description" placeholder="Notes on freight, customs duty or insurance allocation..."/>
              </group>
            </page>
            <page name="valuation_adjustments" string="Valuation Adjustments">
              <field name="valuation_adjustment_lines" readonly="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_stock_landed_cost_search" model="ir.ui.view">
    <field name="name">stock.landed.cost.search</field>
    <field name="model">stock.landed.cost</field>
    <field name="arch" type="xml">
      <search string="Landed Costs">
        <field name="name"/>
        <field name="account_journal_id"/>
        <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="filter_done" string="Posted" domain="[('state', '=', 'done')]"/>
        <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
        <group>
          <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
          <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_stock_landed_cost" model="ir.actions.act_window">
    <field name="name">Landed Costs</field>
    <field name="res_model">stock.landed.cost</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
    <field name="search_view_id" ref="view_stock_landed_cost_search"/>
  </record>

  <menuitem id="menu_stock_landed_cost" name="Landed Costs" parent="stock.menu_stock_operations" action="action_stock_landed_cost" groups="stock.group_stock_manager" sequence="85"/>
  <record id="menu_stock_landed_cost" model="ir.ui.menu"><field name="web_icon">lucide:banknote</field></record>
</erp>
