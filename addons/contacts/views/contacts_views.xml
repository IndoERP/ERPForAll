<?xml version="1.0" encoding="utf-8"?>
<!-- The Contacts app: window actions over res.partner and res.partner.category with the views base ships
     (base.partner_list, base.partner_form, base.partner_search, base.partner_category_*), and the menus. -->
<erp>
  <record id="partner_kanban" model="ir.ui.view">
    <field name="name">res.partner.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <kanban string="Contacts">
        <templates>
          <t t-name="card">
            <main>
              <field name="complete_name"/>
              <field name="email" widget="email"/>
              <field name="phone" widget="phone"/>
              <field name="city"/>
            </main>
            <footer>
              <field name="category_id" widget="many2many_tags"/>
            </footer>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="contacts_overview_list" model="ir.ui.view">
    <field name="name">res.partner.overview.list</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.partner_list"/>
    <field name="mode">primary</field>
    <field name="priority" eval="90"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='complete_name']" position="before">
        <dashboard>
          <count name="companies" string="Companies" filter="companies" color="info"/>
          <count name="individuals" string="Individuals" filter="individuals"/>
        </dashboard>
      </xpath>
    </field>
  </record>

  <record id="contacts_overview_action" model="ir.actions.act_window">
    <field name="name">Contacts Overview</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="contacts_overview_list"/>
    <field name="search_view_id" ref="base.partner_search"/>
  </record>

  <record id="action_contacts" model="ir.actions.act_window">
    <field name="name">Contacts</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="search_view_id" ref="base.partner_search"/>
  </record>
  <record id="action_contacts_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_contacts"/>
    <field name="view_id" ref="base.partner_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_contacts_kanban" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_contacts"/>
    <field name="view_id" ref="partner_kanban"/>
    <field name="view_mode">kanban</field>
    <field name="sequence" eval="15"/>
  </record>
  <record id="action_contacts_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_contacts"/>
    <field name="view_id" ref="base.partner_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <record id="action_contact_tags" model="ir.actions.act_window">
    <field name="name">Contact Tags</field>
    <field name="res_model">res.partner.category</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_contact_tags_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_contact_tags"/>
    <field name="view_id" ref="base.partner_category_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_contact_tags_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_contact_tags"/>
    <field name="view_id" ref="base.partner_category_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <menuitem id="menu_contacts_root" name="Contacts" action="contacts_overview_action" groups="base.group_user" sequence="60" web_icon="lucide:contact">
    <menuitem id="menu_contacts" name="Directory" action="action_contacts" sequence="10"/>
    <menuitem id="menu_contacts_config" name="Configuration" groups="base.group_system" sequence="100">
      <menuitem id="menu_contact_tags" name="Contact Tags" action="action_contact_tags" sequence="10"/>
      <menuitem id="menu_localisation" name="Localization" sequence="20">
        <menuitem id="menu_country_partner" name="Countries" action="base.action_country" sequence="1"/>
        <menuitem id="menu_country_state_partner" name="Fed. States" action="base.action_country_state" sequence="2"/>
        <menuitem id="menu_country_group" name="Country Group" action="base.action_country_group" sequence="3"/>
      </menuitem>
    </menuitem>
  </menuitem>

  <record id="menu_contacts" model="ir.ui.menu"><field name="web_icon">lucide:contact</field></record>
  <record id="menu_contacts_config" model="ir.ui.menu"><field name="web_icon">lucide:sliders-horizontal</field></record>
  <record id="menu_contact_tags" model="ir.ui.menu"><field name="web_icon">lucide:tags</field></record>
  <record id="menu_localisation" model="ir.ui.menu"><field name="web_icon">lucide:globe</field></record>
  <record id="menu_country_partner" model="ir.ui.menu"><field name="web_icon">lucide:globe</field></record>
  <record id="menu_country_state_partner" model="ir.ui.menu"><field name="web_icon">lucide:map</field></record>
  <record id="menu_country_group" model="ir.ui.menu"><field name="web_icon">lucide:git-branch</field></record>
</erp>
