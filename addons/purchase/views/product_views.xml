<erp>
  <record id="product_template_form_purchase_warnings" model="ir.ui.view">
    <field name="name">product.template.form.purchase.warnings</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_purchases" type="object" class="oe_stat_button" icon="lucide:shopping-cart"
                groups="purchase.group_purchase_user" invisible="purchase_order_count == 0">
          <field name="purchase_order_count" widget="statinfo" string="Purchases"/>
        </button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page name="purchase" string="Purchase">
          <group>
            <group name="purchase_bill_control" string="Vendor bills">
              <field name="purchase_method" widget="radio"/>
            </group>
            <group name="purchase_warnings" string="Notice on purchase orders" groups="purchase.group_warning_purchase">
              <field name="purchase_line_warn_msg" placeholder="e.g. Verify specification before ordering."/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</erp>
