<!-- Requests for quotation and purchase orders: Purchase > Orders. The order lines show with the line model's
     default list and open in its form (view_purchase_order_line_list, view_purchase_order_line_form). -->
<erp>
  <record id="view_purchase_order_line_list" model="ir.ui.view">
    <field name="name">purchase.order.line.list</field>
    <field name="model">purchase.order.line</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <list>
        <!-- the line form and the server keep a received or billed line's product and unit -->
        <field name="product_id"/>
        <field name="name"/>
        <field name="analytic_account_id" groups="account.group_cost_center_controlling"/>
        <field name="asset_id" groups="account.group_asset_cip"/>
        <field name="product_qty"/>
        <field name="uom_id"/>
        <field name="date_planned" invisible="1"/>
        <field name="price_unit"/>
        <field name="discount" string="Disc. %"/>
        <field name="tax_ids" widget="many2many_tags"/>
        <field name="currency_id" invisible="1"/>
        <field name="price_subtotal"/>
        <field name="qty_received" invisible="1"/>
        <field name="qty_invoiced" string="Billed"/>
      </list>
    </field>
  </record>

  <record id="view_purchase_order_line_form" model="ir.ui.view">
    <field name="name">purchase.order.line.form</field>
    <field name="model">purchase.order.line</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <!-- An empty unit, description, price and taxes are filled from the product and the vendor when the line is
           saved; the technical price travels with the untouched default price so the server can tell it apart
           from a price typed here. -->
      <form string="Order Line">
        <sheet>
          <field name="purchase_line_warn_msg" readonly="1" invisible="not purchase_line_warn_msg" groups="purchase.group_warning_purchase"/>
          <group>
            <group string="Product and delivery">
              <!-- received or billed goods keep their product and unit -->
              <field name="product_id" readonly="qty_received or qty_invoiced"/>
              <field name="name"/>
              <field name="product_qty"/>
              <field name="uom_id" readonly="qty_received or qty_invoiced"/>
              <field name="date_planned"/>
              <field name="qty_received" readonly="1"/>
              <field name="qty_invoiced" readonly="1"/>
              <field name="qty_to_invoice" readonly="1"/>
              <field name="analytic_account_id" groups="account.group_cost_center_controlling"/>
              <field name="asset_id" groups="account.group_asset_cip"/>
            </group>
            <group string="Pricing">
              <field name="price_unit"/>
              <field name="technical_price_unit" invisible="1"/>
              <field name="discount"/>
              <field name="tax_ids" widget="many2many_tags"/>
              <field name="currency_id" invisible="1" readonly="1"/>
              <field name="price_subtotal" readonly="1"/>
              <field name="price_tax" readonly="1"/>
              <field name="price_total" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="purchase_order_list" model="ir.ui.view">
    <field name="name">purchase.order.list</field>
    <field name="model">purchase.order</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <list>
        <dashboard>
          <count name="rfq" string="RFQs" domain="[('state', 'in', ['draft', 'sent'])]" color="info"/>
          <count name="to_approve" string="To Approve" filter="to_approve" color="warning"/>
          <count name="purchase" string="Purchase Orders" filter="purchase" color="success"/>
          <count name="waiting_bills" string="Waiting Bills" filter="waiting_bills" color="warning"/>
        </dashboard>
        <field name="name" string="Reference"/>
        <field name="partner_id"/>
        <field name="date_order"/>
        <field name="date_approve"/>
        <field name="date_planned"/>
        <field name="user_id" widget="many2one_avatar"/>
        <field name="origin"/>
        <field name="amount_untaxed"/>
        <field name="amount_total"/>
        <field name="currency_id"/>
        <field name="state" widget="badge" options="{'tone_success': ['purchase'], 'tone_info': ['sent'], 'tone_warning': ['draft', 'to approve'], 'tone_danger': ['cancel']}"/>
        <field name="invoice_status" widget="badge" options="{'tone_success': ['invoiced'], 'tone_info': ['to invoice'], 'tone_muted': ['no']}"/>
      </list>
    </field>
  </record>

  <record id="purchase_order_form" model="ir.ui.view">
    <field name="name">purchase.order.form</field>
    <field name="model">purchase.order</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <form string="Purchase Order">
        <header>
          <button name="button_confirm" type="object" string="Confirm Order" class="btn-primary" invisible="state not in ('draft', 'sent')"/>
          <button name="action_open_rfq_send" type="object" string="Send by Email" invisible="state not in ('draft', 'sent')"/>
          <button name="action_open_alternative_wizard" type="object" string="Alternative" invisible="state not in ('draft', 'sent')"/>
          <button name="button_approve" type="object" string="Approve Order" class="btn-primary" invisible="state != 'to approve'" groups="purchase.group_purchase_manager"/>
          <button name="action_create_vendor_bill" type="object" string="Create Bill" groups="account.group_account_user" invisible="state != 'purchase'"/>
          <button name="action_bill_remaining" type="object" string="Bill Remaining" groups="account.group_account_user" invisible="state != 'purchase'"/>
          <button name="action_send_receipt_reminder" type="object" string="Reminder" invisible="state != 'purchase' or mail_reminder_confirmed"/>
          <button name="button_lock" type="object" string="Lock" invisible="state != 'purchase' or locked"/>
          <button name="button_unlock" type="object" string="Unlock" invisible="not locked" groups="purchase.group_purchase_manager"/>
          <button name="button_draft" type="object" string="Set to Draft" invisible="state != 'cancel'"/>
          <button name="button_cancel" type="object" string="Cancel" invisible="state == 'cancel' or locked or cancel_blocked"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,sent,purchase" readonly="1"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_compare_alternatives" type="object" class="oe_stat_button" icon="lucide:layers" invisible="alternative_count == 0">
              <field name="alternative_count" widget="statinfo" string="Alternatives"/>
            </button>
            <button name="action_view_invoice" type="object" class="oe_stat_button" icon="lucide:receipt-text" invisible="invoice_count == 0">
              <field name="invoice_count" widget="statinfo" string="Vendor Bills"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Locked" bg_color="bg-info" invisible="not locked"/>
          <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancel'"/>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <field name="purchase_warning_text" readonly="1" invisible="not purchase_warning_text" groups="purchase.group_warning_purchase"/>
          <group>
            <group>
              <field name="partner_id" readonly="state in ('purchase', 'cancel')"/>
              <field name="requisition_id" readonly="state in ('purchase', 'cancel')"/>
              <field name="origin" readonly="state == 'cancel'"/>
              <field name="currency_id" readonly="state in ('purchase', 'cancel')"/>
              <field name="company_id" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="date_order" readonly="state in ('purchase', 'cancel')"/>
              <field name="date_approve" readonly="1" invisible="state not in ('purchase', 'cancel')"/>
              <field name="date_planned" readonly="1"/>
              <field name="user_id" readonly="state == 'cancel'"/>
              <field name="invoice_status" readonly="1" invisible="state != 'purchase'"/>
              <field name="locked" invisible="1"/>
              <field name="cancel_blocked" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Products" name="products">
              <field name="order_line" context="{'inline_search_field': 'product_id'}" readonly="state == 'cancel' or locked"/>
              <group name="totals">
                <group/>
                <group string="Totals">
                  <field name="amount_untaxed"/>
                  <field name="amount_tax"/>
                  <field name="amount_total"/>
                </group>
              </group>
            </page>
            <page string="Other Info" name="other_info">
              <group>
                <group string="Receipt Reminder">
                  <field name="receipt_reminder_email" readonly="state == 'cancel'"/>
                  <field name="reminder_date_before_receipt" readonly="state == 'cancel'"/>
                  <field name="mail_reminder_confirmed" readonly="1"/>
                </group>
                <group string="Alternatives">
                  <field name="rfq_group_key" readonly="1"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="purchase_order_search" model="ir.ui.view">
    <field name="name">purchase.order.search</field>
    <field name="model">purchase.order</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <search string="Purchase Orders">
        <field name="name" string="Order"/>
        <field name="partner_id"/>
        <field name="user_id"/>
        <field name="origin"/>
        <filter name="draft" string="RFQ" domain="[('state', '=', 'draft')]"/>
        <filter name="sent" string="RFQ Sent" domain="[('state', '=', 'sent')]"/>
        <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to approve')]"/>
        <filter name="purchase" string="Purchase Orders" domain="[('state', '=', 'purchase')]"/>
        <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
        <separator/>
        <filter name="waiting_bills" string="Waiting Bills" domain="[('invoice_status', '=', 'to invoice')]"/>
        <filter name="fully_billed" string="Fully Billed" domain="[('invoice_status', '=', 'invoiced')]"/>
        <separator/>
        <filter name="locked" string="Locked" domain="[('locked', '=', True)]"/>
        <group>
          <filter name="groupby_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
          <filter name="groupby_buyer" string="Buyer" context="{'group_by': 'user_id'}"/>
          <filter name="groupby_date_order" string="Order Deadline" context="{'group_by': 'date_order'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="purchase_overview_action" model="ir.actions.act_window">
    <field name="name">Purchase Overview</field>
    <field name="res_model">purchase.order</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="purchase_order_list"/>
    <field name="search_view_id" ref="purchase_order_search"/>
  </record>

  <!-- Requests for Quotation shows every order, as the reference does; Purchase Orders the confirmed ones. -->
  <record id="purchase_rfq" model="ir.actions.act_window">
    <field name="name">Requests for Quotation</field>
    <field name="res_model">purchase.order</field>
    <field name="view_mode">list,kanban,calendar,form</field>
    <field name="view_id" ref="purchase_order_list"/>
    <field name="search_view_id" ref="purchase_order_search"/>
  </record>
  <record id="purchase_rfq_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="purchase_rfq"/>
    <field name="view_id" ref="purchase_order_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="purchase_rfq_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="purchase_rfq"/>
    <field name="view_id" ref="purchase_order_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="40"/>
  </record>

  <record id="purchase_form_action" model="ir.actions.act_window">
    <field name="name">Purchase Orders</field>
    <field name="res_model">purchase.order</field>
    <field name="view_mode">list,kanban,calendar,form</field>
    <field name="view_id" ref="purchase_order_list"/>
    <field name="search_view_id" ref="purchase_order_search"/>
    <field name="domain">[('state', '=', 'purchase')]</field>
  </record>
  <record id="purchase_form_action_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="purchase_form_action"/>
    <field name="view_id" ref="purchase_order_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="purchase_form_action_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="purchase_form_action"/>
    <field name="view_id" ref="purchase_order_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="40"/>
  </record>

  <record id="purchase_settings_form" model="ir.ui.view">
    <field name="name">purchase.settings.service</field>
    <field name="model">ir.config.setting</field>
    <field name="arch" type="xml">
      <form record_mode="service"><widget name="web.settings" scope_kinds="global,company" app="purchase"/></form>
    </field>
  </record>
  <record id="purchase_settings_action" model="ir.actions.act_window">
    <field name="name">Purchase settings</field>
    <field name="res_model">ir.config.setting</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="purchase_settings_form"/>
  </record>

  <menuitem id="menu_purchase_root" name="Purchase" sequence="40" groups="purchase.group_purchase_user" web_icon="lucide:shopping-cart">
    <menuitem id="menu_purchase_overview" name="Overview" action="purchase_overview_action" sequence="1"/>
    <menuitem id="menu_procurement_management" name="Orders" sequence="10">
      <menuitem id="menu_purchase_rfq" name="Requests for Quotation" action="purchase_rfq" sequence="10"/>
      <menuitem id="menu_purchase_form_action" name="Purchase Orders" action="purchase_form_action" sequence="20"/>
      <menuitem id="menu_purchase_requisition" name="Purchase Agreements" action="action_purchase_requisition" sequence="25"/>
      <menuitem id="menu_purchase_vendors" name="Vendors" action="action_purchase_vendors" sequence="30"/>
    </menuitem>
    <menuitem id="menu_purchase_products" name="Products" sequence="20">
      <menuitem id="menu_purchase_product_template" name="Products" action="product.product_template_action" sequence="10"/>
      <menuitem id="menu_purchase_product_variant" name="Product Variants" action="product.product_product_action" sequence="20"/>
      <menuitem id="menu_purchase_supplierinfo" name="Vendor Pricelists" action="action_product_supplierinfo" sequence="30"/>
    </menuitem>
    <menuitem id="menu_purchase_config" name="Configuration" sequence="100" groups="purchase.group_purchase_manager">
      <menuitem id="menu_purchase_general_settings" name="Settings" action="purchase_settings_action" sequence="10"/>
      <menuitem id="menu_purchase_config_supplierinfo" name="Vendor Pricelists" action="action_product_supplierinfo" sequence="20"/>
    </menuitem>
  </menuitem>

  <record id="menu_procurement_management" model="ir.ui.menu"><field name="web_icon">lucide:clipboard-list</field></record>
  <record id="menu_purchase_overview" model="ir.ui.menu"><field name="web_icon">lucide:panels-top-left</field></record>
  <record id="menu_purchase_rfq" model="ir.ui.menu"><field name="web_icon">lucide:file-text</field></record>
  <record id="menu_purchase_form_action" model="ir.ui.menu"><field name="web_icon">lucide:shopping-cart</field></record>
  <record id="menu_purchase_requisition" model="ir.ui.menu"><field name="web_icon">lucide:file-text</field></record>
  <record id="menu_purchase_vendors" model="ir.ui.menu"><field name="web_icon">lucide:contact</field></record>
  <record id="menu_purchase_products" model="ir.ui.menu"><field name="web_icon">lucide:package</field></record>
  <record id="menu_purchase_product_template" model="ir.ui.menu"><field name="web_icon">lucide:package</field></record>
  <record id="menu_purchase_product_variant" model="ir.ui.menu"><field name="web_icon">lucide:boxes</field></record>
  <record id="menu_purchase_supplierinfo" model="ir.ui.menu"><field name="web_icon">lucide:tag</field></record>
  <record id="menu_purchase_config" model="ir.ui.menu"><field name="web_icon">lucide:sliders-horizontal</field></record>
  <record id="menu_purchase_general_settings" model="ir.ui.menu"><field name="web_icon">lucide:settings</field></record>
  <record id="menu_purchase_config_supplierinfo" model="ir.ui.menu"><field name="web_icon">lucide:tag</field></record>
</erp>
