<erp noupdate="1">
  <record id="res_groups_privilege_inventory" model="res.groups.privilege">
    <field name="name">Inventory</field>
    <field name="description">Control inventory operations and warehouse configuration.</field>
    <field name="placeholder">No inventory role</field>
    <field name="sequence">20</field>
  </record>
  <record id="group_stock_user" model="res.groups">
    <field name="name">User</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_inventory"/>
    <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
  </record>
  <record id="group_stock_manager" model="res.groups">
    <field name="name">Administrator</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_inventory"/>
    <field name="implied_ids" eval="[Command.link(ref('stock.group_stock_user'))]"/>
    <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
  </record>
  <record id="group_stock_multi_locations" model="res.groups">
    <field name="name">Multiple stock locations</field>
  </record>
  <record id="group_stock_multi_warehouses" model="res.groups">
    <field name="name">Multiple warehouses</field>
  </record>
  <record id="group_stock_picking_batch" model="res.groups">
    <field name="name">Grouped stock transfers</field>
  </record>
  <record id="group_production_lot" model="res.groups">
    <field name="name">Lot and serial tracking</field>
  </record>
  <record id="group_stock_lot_print_gs1" model="res.groups">
    <field name="name">GS1 lot and serial labels</field>
  </record>
  <record id="group_lot_on_delivery_slip" model="res.groups">
    <field name="name">Lot details on delivery slips</field>
  </record>
  <record id="group_tracking_lot" model="res.groups">
    <field name="name">Package tracking</field>
  </record>
  <record id="group_adv_location" model="res.groups">
    <field name="name">Advanced inventory routes</field>
  </record>
  <record id="group_tracking_owner" model="res.groups">
    <field name="name">Consignment stock owners</field>
  </record>
  <record id="group_warning_stock" model="res.groups">
    <field name="name">Partner stock warnings</field>
  </record>
  <record id="group_stock_sign_delivery" model="res.groups">
    <field name="name">Delivery signatures</field>
  </record>
</erp>
