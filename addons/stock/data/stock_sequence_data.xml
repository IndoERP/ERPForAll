<!--
Default stock sequences. The orderpoint reference numbering; the name default
     drawn from it comes with the orderpoint behaviour slice. 
-->
<odoo>
  <data noupdate="1">
    <record id="sequence_mrp_op" model="ir.sequence">
      <field name="name">Stock orderpoint</field>
      <field name="code">stock.orderpoint</field>
      <field name="prefix">OP/</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
