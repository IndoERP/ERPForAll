<erp>
  <!-- Transfers: list with a Ready/Waiting strip, form, search. The form offers the workflow methods
       that exist (confirm, check availability, validate, unreserve, cancel). -->
  <record id="view_picking_list" model="ir.ui.view">
    <field name="name">stock.picking.list</field>
    <field name="model">stock.picking</field>
    <field name="arch" type="xml">
      <list string="Transfers">
        <dashboard>
          <count name="ready" string="Ready" filter="available" color="success"/>
          <count name="waiting" string="Waiting" filter="waiting" color="warning"/>
          <count name="draft" string="Draft" filter="draft" color="info"/>
          <count name="done" string="Done" filter="done" color="success"/>
        </dashboard>
        <field name="name"/>
        <field name="location_id"/>
        <field name="location_dest_id"/>
        <field name="partner_id"/>
        <field name="scheduled_date"/>
        <field name="origin"/>
        <field name="state" widget="badge" options="{'tone_success': ['assigned', 'done'], 'tone_info': ['confirmed'], 'tone_warning': ['draft', 'waiting'], 'tone_danger': ['cancel']}"/>
      </list>
    </field>
  </record>
  <record id="view_picking_backorder_choice" model="ir.ui.view">
    <field name="name">stock.picking.backorder.choice</field>
    <field name="model">stock.picking</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <form string="Remaining demand">
        <group string="This transfer is partially fulfilled">
          <field name="name" string="Transfer" readonly="1"/>
          <field name="move_ids" string="Operations" readonly="1"/>
        </group>
        <footer>
          <button type="object" name="action_keep_backorder" string="Create Backorder" class="btn-primary"/>
          <button type="object" name="action_close_remainder" string="Close Remaining Demand"/>
          <button special="cancel" string="Cancel" data-hotkey="x"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="name">stock.picking.form</field>
    <field name="model">stock.picking</field>
    <field name="arch" type="xml">
      <form string="Transfer">
        <header>
          <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="action_return_all" type="object" string="Return All" class="oe_highlight" invisible="not return_id or state in ('done', 'cancel')"/>
          <button name="action_assign" type="object" string="Check Availability" class="oe_highlight" invisible="state not in ('confirmed', 'waiting', 'assigned')"/>
          <button name="action_validate_transfer" type="object" string="Validate" data-hotkey="v" class="oe_highlight" invisible="state not in ('draft', 'confirmed', 'waiting', 'assigned')"/>
          <button name="action_put_in_pack" type="object" string="Put in Pack" groups="stock.group_tracking_lot" invisible="state not in ('confirmed', 'waiting', 'assigned')"/>
          <button name="action_return" type="object" string="Return" invisible="state != 'done' or not show_return"/>
          <button name="action_exchange" type="object" string="Exchange" invisible="state != 'done' or not return_id"/>
          <button name="action_scrap" type="object" string="Scrap" invisible="state in ('draft', 'cancel')"/>
          <button name="do_unreserve" type="object" string="Unreserve" invisible="state not in ('assigned', 'confirmed', 'waiting')"/>
          <button name="action_cancel" type="object" string="Cancel" data-hotkey="x" invisible="state not in ('assigned', 'confirmed', 'draft', 'waiting')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,assigned,done"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_returns" type="object" class="oe_stat_button" icon="lucide:undo-2" invisible="return_count == 0">
              <field name="return_count" widget="statinfo" string="Returns"/>
            </button>
            <button name="action_view_backorders" type="object" class="oe_stat_button" icon="lucide:git-branch" invisible="backorder_count == 0">
              <field name="backorder_count" widget="statinfo" string="Backorders"/>
            </button>
            <button name="action_view_scraps" type="object" class="oe_stat_button" icon="lucide:archive" invisible="scrap_count == 0">
              <field name="scrap_count" widget="statinfo" string="Scraps"/>
            </button>
          </div>
          <field name="show_return" invisible="1"/>
          <widget name="web_ribbon" title="Done" bg_color="bg-success" invisible="state != 'done'"/>
          <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancel'"/>
          <div class="oe_title"><h1><field name="name" readonly="state in ('done', 'cancel')"/></h1></div>
          <field name="picking_warning_text" readonly="1" invisible="not picking_warning_text" groups="stock.group_warning_stock"/>
          <!-- a done or cancelled transfer keeps only the server's allow-list editable (origin, responsible) -->
          <group>
            <group>
              <field name="partner_id" readonly="state in ('done', 'cancel')"/>
              <field name="owner_id" groups="stock.group_tracking_owner" readonly="state in ('done', 'cancel')"/>
              <field name="picking_type_id" readonly="state in ('done', 'cancel')"/>
              <field name="location_id" readonly="state in ('done', 'cancel')"/>
              <field name="location_dest_id" readonly="state in ('done', 'cancel')"/>
            </group>
            <group>
              <field name="scheduled_date" readonly="state in ('done', 'cancel')"/>
              <field name="origin"/>
              <field name="backorder_id" readonly="1" invisible="not backorder_id"/>
              <field name="return_id" readonly="1" invisible="not return_id"/>
            </group>
          </group>
          <notebook>
            <!-- Products are added while the transfer is a draft, through the move list and form below; the
                 server gives each new move the transfer's company, locations and operation type. -->
            <page name="operations" string="Operations">
              <field name="move_ids" readonly="state != 'draft'"/>
            </page>
            <!-- the done quantity of an open transfer is set on its lines; done work is fixed -->
            <page name="detailed_operations" string="Detailed Operations">
              <field name="move_line_ids" readonly="state in ('draft', 'done', 'cancel')"/>
            </page>
            <page name="extra" string="Additional Info">
              <group>
                <group>
                  <field name="user_id"/>
                  <field name="move_type" readonly="state in ('done', 'cancel')"/>
                </group>
                <group>
                  <field name="company_id" readonly="state in ('done', 'cancel')"/>
                  <field name="date_deadline" readonly="state in ('done', 'cancel')"/>
                  <field name="date_done"/>
                </group>
              </group>
              <group name="delivery_signature" string="Delivery Signature" groups="stock.group_stock_sign_delivery">
                <field name="signed_by" placeholder="Recipient name"/>
                <field name="signature" placeholder="Recipient signature note or reference"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <!-- The default list and form of a move and of a move line: the transfer form shows its one2many lines with
       them (the client uses a comodel's default views for a one2many). -->
  <record id="view_stock_move_lines" model="ir.ui.view">
    <field name="name">stock.move.lines</field>
    <field name="model">stock.move</field>
    <field name="arch" type="xml">
      <list>
        <field name="product_id"/>
        <field name="product_uom_qty" string="Demand"/>
        <field name="quantity" readonly="1"/>
        <field name="uom_id" string="Unit"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_stock_move_form" model="ir.ui.view">
    <field name="name">stock.move.form</field>
    <field name="model">stock.move</field>
    <field name="arch" type="xml">
      <form string="Stock Move">
        <sheet>
          <group>
            <group>
              <!-- a done or cancelled move is fixed outside its descriptions and links -->
              <field name="product_id" readonly="state in ('done', 'cancel')"/>
              <field name="product_uom_qty" string="Demand" readonly="state in ('done', 'cancel')"/>
              <field name="uom_id" string="Unit" readonly="state in ('done', 'cancel')"/>
            </group>
            <group>
              <!-- taken from the transfer on the server, so a new line does not ask for them -->
              <field name="location_id" readonly="1"/>
              <field name="location_dest_id" readonly="1"/>
              <field name="quantity" readonly="1"/>
              <field name="state" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_stock_move_line_lines" model="ir.ui.view">
    <field name="name">stock.move.line.lines</field>
    <field name="model">stock.move.line</field>
    <field name="arch" type="xml">
      <list>
        <field name="product_id"/>
        <field name="location_id"/>
        <field name="location_dest_id"/>
        <field name="lot_id" groups="stock.group_production_lot"/>
        <field name="lot_name" groups="stock.group_production_lot"/>
        <field name="package_id" groups="stock.group_tracking_lot"/>
        <field name="result_package_id" groups="stock.group_tracking_lot"/>
        <field name="quantity"/>
        <field name="uom_id" string="Unit"/>
      </list>
    </field>
  </record>
  <record id="view_stock_move_line_form" model="ir.ui.view">
    <field name="name">stock.move.line.form</field>
    <field name="model">stock.move.line</field>
    <field name="arch" type="xml">
      <form string="Move Line">
        <sheet>
          <group>
            <group>
              <field name="product_id"/>
              <field name="quantity"/>
              <field name="uom_id" string="Unit"/>
              <field name="lot_id" groups="stock.group_production_lot"/>
              <field name="lot_name" groups="stock.group_production_lot"/>
            </group>
            <group>
              <field name="location_id"/>
              <field name="location_dest_id"/>
              <field name="package_id" groups="stock.group_tracking_lot"/>
              <field name="result_package_id" groups="stock.group_tracking_lot"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Late is not offered yet: view domains have no clock (erp-expr), so "before today" cannot be
       written here. The overview card's Late link carries today's date from the server instead. -->
  <record id="view_picking_search" model="ir.ui.view">
    <field name="name">stock.picking.search</field>
    <field name="model">stock.picking</field>
    <field name="arch" type="xml">
      <search string="Transfers">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="origin"/>
        <field name="picking_type_id"/>
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="waiting" string="Waiting" domain="[('state', 'in', ['confirmed', 'waiting'])]"/>
        <filter name="available" string="Ready" domain="[('state', '=', 'assigned')]"/>
        <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
        <group>
          <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
          <filter name="group_picking_type" string="Operation Type" context="{'group_by': 'picking_type_id'}"/>
          <filter name="group_scheduled_date" string="Scheduled Date" context="{'group_by': 'scheduled_date'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_picking_tree_all" model="ir.actions.act_window">
    <field name="name">Transfers</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_picking_search"/>
  </record>
  <record id="action_picking_tree_incoming" model="ir.actions.act_window">
    <field name="name">Receipts</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('picking_type_id.code', '=', 'incoming')]</field>
    <field name="search_view_id" ref="view_picking_search"/>
  </record>
  <record id="action_picking_tree_outgoing" model="ir.actions.act_window">
    <field name="name">Deliveries</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('picking_type_id.code', '=', 'outgoing')]</field>
    <field name="search_view_id" ref="view_picking_search"/>
  </record>
  <record id="action_picking_tree_internal" model="ir.actions.act_window">
    <field name="name">Internal Transfers</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('picking_type_id.code', '=', 'internal')]</field>
    <field name="search_view_id" ref="view_picking_search"/>
  </record>
  <record id="action_picking_tree_returns" model="ir.actions.act_window">
    <field name="name">Returns</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('return_id', '!=', False)]</field>
    <field name="search_view_id" ref="view_picking_search"/>
  </record>
  <record id="view_stock_move_line_search" model="ir.ui.view">
    <field name="name">stock.move.line.search</field>
    <field name="model">stock.move.line</field>
    <field name="arch" type="xml">
      <search string="Moves History">
        <field name="product_id"/>
        <field name="lot_id"/>
        <field name="location_id"/>
        <field name="location_dest_id"/>
        <field name="picking_id"/>
        <filter name="done" string="Done" domain="[('membership', '=', 'done')]"/>
        <filter name="open" string="Open" domain="[('membership', '=', 'open')]"/>
        <group>
          <filter name="groupby_product" string="Product" context="{'group_by': 'product_id'}"/>
          <filter name="groupby_location" string="From" context="{'group_by': 'location_id'}"/>
          <filter name="groupby_location_dest" string="To" context="{'group_by': 'location_dest_id'}"/>
          <filter name="groupby_lot" string="Lot/Serial" context="{'group_by': 'lot_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_stock_move_line_history" model="ir.actions.act_window">
    <field name="name">Moves History</field>
    <field name="res_model">stock.move.line</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('membership', '=', 'done')]</field>
    <field name="search_view_id" ref="view_stock_move_line_search"/>
  </record>
  <menuitem id="menu_stock_operations" name="Operations" parent="menu_stock_root" sequence="10"/>
  <menuitem id="menu_stock_receipts" name="Receipts" parent="menu_stock_operations" action="action_picking_tree_incoming" sequence="10"/>
  <menuitem id="menu_stock_deliveries" name="Deliveries" parent="menu_stock_operations" action="action_picking_tree_outgoing" sequence="20"/>
  <menuitem id="menu_stock_internal" name="Internal Transfers" parent="menu_stock_operations" action="action_picking_tree_internal" sequence="30"/>
  <menuitem id="menu_stock_all_transfers" name="All Transfers" parent="menu_stock_operations" action="action_picking_tree_all" sequence="40"/>

  <record id="menu_stock_operations" model="ir.ui.menu"><field name="web_icon">lucide:workflow</field></record>
  <record id="menu_stock_receipts" model="ir.ui.menu"><field name="web_icon">lucide:inbox</field></record>
  <record id="menu_stock_deliveries" model="ir.ui.menu"><field name="web_icon">lucide:truck</field></record>
  <record id="menu_stock_internal" model="ir.ui.menu"><field name="web_icon">lucide:redo-2</field></record>
  <record id="menu_stock_all_transfers" model="ir.ui.menu"><field name="web_icon">lucide:list</field></record>
</erp>
