<!-- Settings > Technical > Reporting > Dynamic Reports: the report definitions, for administrators. -->
<erp>
    <record id="reporting_report_list" model="ir.ui.view">
        <field name="name">reporting.report.list</field>
        <field name="model">reporting.report</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="provider"/><field name="date_mode"/><field name="comparison"/><field name="active"/></list></field>
    </record>
    <record id="reporting_report_form" model="ir.ui.view">
        <field name="name">reporting.report.form</field>
        <field name="model">reporting.report</field>
        <field name="arch" type="xml"><form record_mode="record">
            <header><button name="action_open_report" type="object" string="Open Report" class="btn-primary"/></header>
            <sheet>
                <group>
                    <group><field name="name"/><field name="provider"/><field name="active"/></group>
                    <group><field name="date_mode"/><field name="date_default"/><field name="comparison"/><field name="multi_company"/></group>
                </group>
                <group>
                    <group><field name="unfold_all"/><field name="hide_zero"/><field name="search_bar"/></group>
                    <group><field name="totals_below"/><field name="load_more_limit"/></group>
                </group>
                <notebook>
                    <page name="lines" string="Lines">
                        <field name="line_ids"/>
                    </page>
                    <page name="columns" string="Columns">
                        <field name="column_ids"/>
                    </page>
                </notebook>
            </sheet>
        </form></field>
    </record>
    <record id="reporting_report_search" model="ir.ui.view">
        <field name="name">reporting.report.search</field>
        <field name="model">reporting.report</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="provider"/></search></field>
    </record>
    <record id="reporting_report_line_list" model="ir.ui.view">
        <field name="name">reporting.report.line.list</field>
        <field name="model">reporting.report.line</field>
        <field name="arch" type="xml"><list><field name="sequence"/><field name="name"/><field name="code"/><field name="groupby"/><field name="foldable"/></list></field>
    </record>
    <record id="reporting_report_line_form" model="ir.ui.view">
        <field name="name">reporting.report.line.form</field>
        <field name="model">reporting.report.line</field>
        <field name="arch" type="xml"><form record_mode="record"><group><field name="sequence"/><field name="name"/><field name="code"/><field name="parent_id"/><field name="groupby"/><field name="foldable"/><field name="hide_if_zero"/><field name="optional"/><field name="expression_ids"/></group></form></field>
    </record>
    <record id="reporting_report_column_list" model="ir.ui.view">
        <field name="name">reporting.report.column.list</field>
        <field name="model">reporting.report.column</field>
        <field name="arch" type="xml"><list><field name="sequence"/><field name="name"/><field name="label"/><field name="kind"/></list></field>
    </record>
    <record id="reporting_report_column_form" model="ir.ui.view">
        <field name="name">reporting.report.column.form</field>
        <field name="model">reporting.report.column</field>
        <field name="arch" type="xml"><form record_mode="record"><group><field name="sequence"/><field name="name"/><field name="label"/><field name="kind"/><field name="scale"/><field name="sortable"/><field name="blank_if_zero"/><field name="rollup"/><field name="rollup_field"/></group></form></field>
    </record>
    <record id="reporting_report_expression_list" model="ir.ui.view">
        <field name="name">reporting.report.expression.list</field>
        <field name="model">reporting.report.expression</field>
        <field name="arch" type="xml"><list><field name="label"/><field name="engine"/><field name="model"/><field name="field"/></list></field>
    </record>
    <record id="reporting_report_expression_form" model="ir.ui.view">
        <field name="name">reporting.report.expression.form</field>
        <field name="model">reporting.report.expression</field>
        <field name="arch" type="xml"><form record_mode="record"><group><field name="label"/><field name="engine"/><field name="model"/><field name="domain"/><field name="field"/><field name="formula"/><field name="date_field"/><field name="date_scope"/><field name="zero_division"/></group></form></field>
    </record>
    <!-- Lines and expressions as top-level records (menu entries below): they name their report or line, which the
         nested forms above leave out, and a line opened here edits its expressions (a line opened in the dialog of
         its report shows them read-only: the client never writes nested lines from a line). The higher priority
         keeps the nested views above the default ones. -->
    <record id="reporting_report_line_main_list" model="ir.ui.view">
        <field name="name">reporting.report.line.main.list</field>
        <field name="model">reporting.report.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml"><list><field name="report_id"/><field name="sequence"/><field name="name"/><field name="code"/><field name="parent_id"/><field name="groupby"/></list></field>
    </record>
    <record id="reporting_report_line_main_form" model="ir.ui.view">
        <field name="name">reporting.report.line.main.form</field>
        <field name="model">reporting.report.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml"><form record_mode="record"><group><field name="report_id"/><field name="sequence"/><field name="name"/><field name="code"/><field name="parent_id"/><field name="groupby"/><field name="foldable"/><field name="hide_if_zero"/><field name="optional"/><field name="expression_ids"/></group></form></field>
    </record>
    <record id="reporting_report_expression_main_list" model="ir.ui.view">
        <field name="name">reporting.report.expression.main.list</field>
        <field name="model">reporting.report.expression</field>
        <field name="priority">99</field>
        <field name="arch" type="xml"><list><field name="line_id"/><field name="label"/><field name="engine"/><field name="model"/><field name="field"/></list></field>
    </record>
    <record id="reporting_report_expression_main_form" model="ir.ui.view">
        <field name="name">reporting.report.expression.main.form</field>
        <field name="model">reporting.report.expression</field>
        <field name="priority">99</field>
        <field name="arch" type="xml"><form record_mode="record"><group><field name="line_id"/><field name="label"/><field name="engine"/><field name="model"/><field name="domain"/><field name="field"/><field name="formula"/><field name="date_field"/><field name="date_scope"/><field name="zero_division"/></group></form></field>
    </record>
    <record id="action_reporting_report" model="ir.actions.act_window">
        <field name="name">Dynamic Reports</field>
        <field name="res_model">reporting.report</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="reporting_report_list"/>
        <field name="search_view_id" ref="reporting_report_search"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'), 0)]"/>
    </record>
    <menuitem id="menu_reporting_report" name="Dynamic Reports" parent="base.technical_reporting_menu"
              action="action_reporting_report" groups="base.group_system" sequence="5"/>
    <record id="action_reporting_report_line" model="ir.actions.act_window">
        <field name="name">Report Lines</field>
        <field name="res_model">reporting.report.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="reporting_report_line_main_list"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'), 0)]"/>
    </record>
    <record id="action_reporting_report_line_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_reporting_report_line"/>
        <field name="view_id" ref="reporting_report_line_main_list"/>
        <field name="view_mode">list</field>
        <field name="sequence" eval="10"/>
    </record>
    <record id="action_reporting_report_line_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_reporting_report_line"/>
        <field name="view_id" ref="reporting_report_line_main_form"/>
        <field name="view_mode">form</field>
        <field name="sequence" eval="20"/>
    </record>
    <menuitem id="menu_reporting_report_line" name="Report Lines" parent="base.technical_reporting_menu"
              action="action_reporting_report_line" groups="base.group_system" sequence="6"/>
    <record id="action_reporting_report_expression" model="ir.actions.act_window">
        <field name="name">Report Expressions</field>
        <field name="res_model">reporting.report.expression</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="reporting_report_expression_main_list"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'), 0)]"/>
    </record>
    <record id="action_reporting_report_expression_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_reporting_report_expression"/>
        <field name="view_id" ref="reporting_report_expression_main_list"/>
        <field name="view_mode">list</field>
        <field name="sequence" eval="10"/>
    </record>
    <record id="action_reporting_report_expression_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_reporting_report_expression"/>
        <field name="view_id" ref="reporting_report_expression_main_form"/>
        <field name="view_mode">form</field>
        <field name="sequence" eval="20"/>
    </record>
    <menuitem id="menu_reporting_report_expression" name="Report Expressions" parent="base.technical_reporting_menu"
              action="action_reporting_report_expression" groups="base.group_system" sequence="7"/>

  <record id="menu_reporting_report" model="ir.ui.menu"><field name="web_icon">lucide:chart-column</field></record>

  <record id="menu_reporting_report_line" model="ir.ui.menu"><field name="web_icon">lucide:list</field></record>
  <record id="menu_reporting_report_expression" model="ir.ui.menu"><field name="web_icon">lucide:calculator</field></record>
</erp>
