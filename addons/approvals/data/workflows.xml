<erp>
  <record id="workflow_step_list" model="ir.ui.view">
    <field name="name">approval.workflow.step.list</field>
    <field name="model">approval.workflow.step</field>
    <field name="arch" type="xml">
      <list string="Review steps">
        <field name="sequence" string="Order" width="65px"/>
        <field name="name" string="Step"/>
        <field name="user_ids" string="Users" widget="many2many_tags"/>
        <field name="group_ids" string="Groups" widget="many2many_tags"/>
      </list>
    </field>
  </record>
  <record id="workflow_step_form" model="ir.ui.view">
    <field name="name">approval.workflow.step.form</field>
    <field name="model">approval.workflow.step</field>
    <field name="arch" type="xml">
      <form string="Review step">
        <sheet>
          <group>
            <field name="name" string="Step name" placeholder="e.g. Finance review"/>
            <field name="sequence" string="Order"/>
          </group>
          <group string="Eligible reviewers">
            <field name="user_ids" string="Users" widget="many2many_tags" options="{'no_create': True}" domain="[('active', '=', True), ('share', '=', False), ('id', '!=', 1)]"/>
            <field name="group_ids" string="Groups" widget="many2many_tags" options="{'no_create': True}"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="workflow_list" model="ir.ui.view">
    <field name="name">approval.workflow.list</field>
    <field name="model">approval.workflow</field>
    <field name="arch" type="xml">
      <list string="Workflows">
        <field name="name" string="Workflow"/>
        <field name="company_id" string="Company"/>
        <field name="model_id" string="Model"/>
        <field name="method" string="Operation"/>
        <field name="state" string="Status" widget="badge"/>
      </list>
    </field>
  </record>
  <record id="workflow_form" model="ir.ui.view">
    <field name="name">approval.workflow.form</field>
    <field name="model">approval.workflow</field>
    <field name="arch" type="xml">
      <form string="Approval workflow" edit_mode="read" delete="0">
        <header>
          <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft' or replaces_policy_id"/>
          <button name="action_publish" type="object" string="Publish revision" class="btn-primary" invisible="state != 'draft' or not replaces_policy_id"
                  confirm="Publish this revision and expire incomplete requests under the previous revision?"/>
          <button name="action_create_revision" type="object" string="Create revision" class="btn-primary" invisible="state == 'draft'"/>
          <button name="action_archive_workflow" type="object" string="Archive" invisible="state != 'active'"
                  confirm="Archive this workflow and expire its incomplete requests?"/>
          <button name="action_activate" type="object" string="Activate" invisible="state != 'inactive'"/>
          <field name="state" widget="statusbar" readonly="1"/>
        </header>
        <sheet>
          <field name="replaces_policy_id" invisible="1"/>
          <div class="oe_title"><h1><field name="name" string="Workflow name" placeholder="e.g. Purchase order approval" readonly="state != 'draft'"/></h1></div>
          <group>
            <group string="Applies to">
              <field name="company_id" string="Company" options="{'no_create': True}" placeholder="All companies" readonly="state != 'draft'"/>
              <field name="principal_kind" string="Requester type" readonly="state != 'draft'"/>
            </group>
            <group string="Operation">
              <field name="effect" string="Operation effect" readonly="state != 'draft'"/>
              <field name="model_id" string="Model" options="{'no_create': True}" placeholder="All models" readonly="state != 'draft'"/>
              <field name="method" string="Method" widget="approvals.method" readonly="state != 'draft' or not model_id"/>
            </group>
          </group>
          <notebook>
            <page name="steps" string="Review steps">
              <field name="step_ids" readonly="state != 'draft'" context="{'list_view_ref': 'approvals.workflow_step_list', 'form_view_ref': 'approvals.workflow_step_form'}"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="workflow_search" model="ir.ui.view">
    <field name="name">approval.workflow.search</field>
    <field name="model">approval.workflow</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Workflow"/>
        <field name="company_id"/>
        <field name="model_id"/>
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
        <filter name="archived" string="Archived" domain="[('state', '=', 'inactive')]"/>
      </search>
    </field>
  </record>
  <record id="workflows_window" model="ir.actions.act_window">
    <field name="name">Workflows</field>
    <field name="res_model">approval.workflow</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="workflow_list"/>
    <field name="search_view_id" ref="workflow_search"/>
    <field name="group_ids" eval="[(4, ref('base.group_system'), 0)]"/>
  </record>
</erp>
