<!--
Accounting groups, from the least to the most access. The full matrix and the other groups of
     the reference come with, which extends these records instead of redefining them.
-->
<erp noupdate="1">
  <record id="group_account_readonly" model="res.groups">
    <field name="name">Show Accounting Features - Readonly</field>
    <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
  </record>

  <record id="group_account_user" model="res.groups">
    <field name="name">Show Full Accounting Features</field>
    <field name="implied_ids" eval="[Command.link(ref('group_account_readonly'))]"/>
  </record>

  <record id="group_account_manager" model="res.groups">
    <field name="name">Accounting Administrator</field>
    <field name="implied_ids" eval="[Command.link(ref('group_account_user'))]"/>
    <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
  </record>
</erp>
