<!-- Demo taxes of the main company with explicit tax payable/receivable repartition accounts
     and demo perpetual stock valuation defaults on the main company. Invented records. -->
<erp noupdate="1">
  <record id="tax_group_demo_vat" model="account.tax.group">
    <field name="name">VAT</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="country_id" ref="base.us"/>
    <field name="sequence">10</field>
  </record>

  <record id="tax_demo_sale_11" model="account.tax">
    <field name="name">VAT 11% (Sales)</field>
    <field name="type_tax_use">sale</field>
    <field name="amount_type">percent</field>
    <field name="amount">11</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="country_id" ref="base.us"/>
    <field name="tax_group_id" ref="tax_group_demo_vat"/>
    <field name="invoice_repartition_line_ids" eval="[
      (5, 0, 0),
      (0, 0, {'repartition_type': 'base', 'document_type': 'invoice', 'factor_percent': 100}),
      (0, 0, {'repartition_type': 'tax', 'document_type': 'invoice', 'factor_percent': 100, 'account_id': ref('account_demo_tax_payable')}),
    ]"/>
    <field name="refund_repartition_line_ids" eval="[
      (5, 0, 0),
      (0, 0, {'repartition_type': 'base', 'document_type': 'refund', 'factor_percent': 100}),
      (0, 0, {'repartition_type': 'tax', 'document_type': 'refund', 'factor_percent': 100, 'account_id': ref('account_demo_tax_payable')}),
    ]"/>
  </record>

  <record id="tax_demo_purchase_11" model="account.tax">
    <field name="name">VAT 11% (Purchases)</field>
    <field name="type_tax_use">purchase</field>
    <field name="amount_type">percent</field>
    <field name="amount">11</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="country_id" ref="base.us"/>
    <field name="tax_group_id" ref="tax_group_demo_vat"/>
    <field name="invoice_repartition_line_ids" eval="[
      (5, 0, 0),
      (0, 0, {'repartition_type': 'base', 'document_type': 'invoice', 'factor_percent': 100}),
      (0, 0, {'repartition_type': 'tax', 'document_type': 'invoice', 'factor_percent': 100, 'account_id': ref('account_demo_tax_receivable')}),
    ]"/>
    <field name="refund_repartition_line_ids" eval="[
      (5, 0, 0),
      (0, 0, {'repartition_type': 'base', 'document_type': 'refund', 'factor_percent': 100}),
      (0, 0, {'repartition_type': 'tax', 'document_type': 'refund', 'factor_percent': 100, 'account_id': ref('account_demo_tax_receivable')}),
    ]"/>
  </record>

  <record id="base.main_company" model="res.company">
    <field name="account_stock_valuation_id" ref="account_demo_goods"/>
    <field name="anglo_saxon_accounting" eval="True"/>
    <field name="cost_method">average</field>
  </record>
</erp>
