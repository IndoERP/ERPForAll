    <field name="account_type">income_other</field>
    <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
  </record>

  <!-- Expenses -->
  <record id="account_demo_cost_of_sales" model="account.account">
    <field name="name">Cost of Goods Sold</field>
    <field name="code">501000</field>
    <field name="account_type">expense_direct_cost</field>
    <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
  </record>
  <record id="account_demo_purchases" model="account.account">
    <field name="name">Purchased Supplies</field>
    <field name="code">511000</field>
    <field name="account_type">expense</field>
    <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
  </record>
  <record id="account_demo_office_rent" model="account.account">
    <field name="name">Office Rent</field>
    <field name="code">611000</field>
    <field name="account_type">expense</field>
    <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
    <field name="tag_ids" eval="[(6, 0, [ref('account_tag_demo_premises')])]"/>
  </record>
  <record id="account_demo_salaries" model="account.account">
    <field name="name">Salaries and Wages</field>
    <field name="code">621000</field>
    <field name="account_type">expense</field>
    <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
    <field name="tag_ids" eval="[(6, 0, [ref('account_tag_demo_payroll')])]"/>
  </record>
  <record id="account_demo_depreciation" model="account.account">
    <field name="name">Depreciation of Equipment</field>
    <field name="code">681000</field>
    <field name="account_type">expense_depreciation</field>
    <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
  </record>
  <record id="account_demo_bank_charges" model="account.account">
    <field name="name">Bank Charges</field>
    <field name="code">691000</field>
    <field name="account_type">expense_other</field>
    <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
  </record>
</erp>
