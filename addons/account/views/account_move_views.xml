<!-- Journal entries and journal items, Accounting > Accounting. -->
<erp>
  <record id="view_move_list" model="ir.ui.view">
    <field name="name">account.move.list</field>
    <field name="model">account.move</field>
    <field name="arch" type="xml">
      <list>
        <field name="date"/>
        <field name="name"/>
        <field name="journal_id"/>
        <field name="partner_id"/>
        <field name="ref"/>
        <field name="currency_id" invisible="1"/>
        <field name="amount_total"/>
        <field name="state" widget="badge" options="{'tone_success': ['posted'], 'tone_warning': ['draft'], 'tone_danger': ['cancel']}"/>
      </list>
    </field>
  </record>

  <record id="view_move_form" model="ir.ui.view">
    <field name="name">account.move.form</field>
    <field name="model">account.move</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="action_reverse" type="object" string="Reverse Entry" invisible="state != 'posted'"/>
          <button name="button_draft" type="object" string="Reset to Draft" invisible="reset_blocked"/>
          <button name="button_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_payments" type="object" class="oe_stat_button" icon="lucide:banknote" invisible="payment_count == 0">
              <field name="payment_count" widget="statinfo" string="Payments"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancel'"/>
          <div class="oe_title">
            <h1><field name="name" readonly="1" invisible="not name"/><field name="display_name" readonly="1" invisible="name"/></h1>
          </div>
          <!-- a posted or cancelled entry keeps only its reference editable, as the server does -->
          <group>
            <group>
              <field name="reset_blocked" invisible="1"/>
              <field name="move_type" invisible="1" readonly="state != 'draft'"/>
              <field name="date" readonly="state != 'draft'"/>
              <field name="journal_id" readonly="state != 'draft'"/>
              <field name="ref"/>
            </group>
            <group>
              <field name="partner_id" readonly="state != 'draft'"/>
              <field name="company_id" readonly="state != 'draft'"/>
              <field name="currency_id" readonly="state != 'draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Journal Items" name="journal_items">
              <!-- The lines show with the line model's default list (view_move_line_lines) and open in its form.
                   The items of an invoice or bill follow its product lines: they are edited in the invoice form. -->
              <field name="line_ids" readonly="move_type != 'entry' or state != 'draft'"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_move_search" model="ir.ui.view">
    <field name="name">account.move.search</field>
    <field name="model">account.move</field>
    <field name="arch" type="xml">
      <search string="Journal Entries">
        <field name="name"/>
        <field name="ref"/>
        <field name="partner_id"/>
        <field name="journal_id"/>
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
        <separator/>
        <filter name="misc" string="Miscellaneous" domain="[('journal_id.type', '=', 'general')]"/>
        <filter name="sales" string="Sales" domain="[('journal_id.type', '=', 'sale')]"/>
        <filter name="purchases" string="Purchases" domain="[('journal_id.type', '=', 'purchase')]"/>
        <filter name="liquidity" string="Bank and Cash" domain="[('journal_id.type', 'in', ('bank', 'cash', 'credit'))]"/>
        <group>
          <filter name="groupby_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
          <filter name="groupby_date" string="Date" context="{'group_by': 'date'}"/>
          <filter name="groupby_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_move_journal_line" model="ir.actions.act_window">
    <field name="name">Journal Entries</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_move_list"/>
    <field name="search_view_id" ref="view_move_search"/>
    <!-- New creates a miscellaneous entry. -->
    <!-- Named, although empty: an upgrade writes only the fields a record names, and a database installed before
         this change still holds the old domain (seen on the dev/testing server on 2026-11-17: two rows). -->
    <field name="domain">[]</field>
    <field name="context">{'default_move_type': 'entry'}</field>
  </record>

  <!-- The default list of a line: the journal items of an entry (the entry form and the Journal Items tab of an
       invoice). An invoice names its own list and form for its product lines (account_invoice_views.xml). -->
  <record id="view_move_line_lines" model="ir.ui.view">
    <field name="name">account.move.line.lines</field>
    <field name="model">account.move.line</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <list>
        <field name="account_id"/>
        <field name="partner_id"/>
        <field name="name"/>
        <field name="analytic_account_id" groups="account.group_cost_center_controlling"/>
        <field name="tax_ids" widget="many2many_tags"/>
        <field name="currency_id" invisible="1"/>
        <field name="debit"/>
        <field name="credit"/>
      </list>
    </field>
  </record>

  <record id="view_move_line_form" model="ir.ui.view">
    <field name="name">account.move.line.form</field>
    <field name="model">account.move.line</field>
    <field name="arch" type="xml">
      <form string="Journal Item">
        <sheet>
          <!-- an item of a posted or cancelled entry keeps only its label and due date editable -->
          <field name="parent_state" invisible="1"/>
          <group>
            <group>
              <field name="account_id" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="partner_id" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="analytic_account_id" groups="account.group_cost_center_controlling" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="trading_partner_company_id" groups="account.group_group_consolidation" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="name"/>
              <field name="display_type" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="date_maturity"/>
            </group>
            <group>
              <field name="product_id" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="quantity" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="product_uom_id" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="price_unit" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="discount" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="tax_ids" widget="many2many_tags" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="price_subtotal" readonly="1"/>
            </group>
          </group>
          <group>
            <group>
              <field name="amount_currency" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="currency_id" readonly="parent_state in ('posted', 'cancel')"/>
            </group>
            <group>
              <field name="debit" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="credit" readonly="parent_state in ('posted', 'cancel')"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- The form the Journal Items action opens: read only. The client takes editability from the form's own root,
       so the editable line form of an entry (above) cannot serve; the high priority keeps this one from being
       any model's default. -->
  <record id="view_move_line_readonly_form" model="ir.ui.view">
    <field name="name">account.move.line.readonly.form</field>
    <field name="priority" eval="99"/>
    <field name="model">account.move.line</field>
    <field name="arch" type="xml">
      <form string="Journal Item" record_mode="record" create="false" edit="false" delete="false">
        <sheet>
          <group>
            <group>
              <field name="account_id"/>
              <field name="partner_id"/>
              <field name="name"/>
              <field name="display_type"/>
              <field name="date_maturity"/>
            </group>
            <group>
              <field name="product_id"/>
              <field name="quantity"/>
              <field name="product_uom_id"/>
              <field name="price_unit"/>
              <field name="discount"/>
              <field name="tax_ids" widget="many2many_tags"/>
              <field name="price_subtotal" readonly="1"/>
            </group>
          </group>
          <group>
            <group>
              <field name="amount_currency"/>
              <field name="currency_id"/>
            </group>
            <group>
              <field name="debit"/>
              <field name="credit"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_move_line_list" model="ir.ui.view">
    <field name="name">account.move.line.list</field>
    <field name="model">account.move.line</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="date"/>
        <field name="move_name"/>
        <field name="journal_id"/>
        <field name="account_id"/>
        <field name="partner_id"/>
        <field name="name"/>
        <field name="debit"/>
        <field name="credit"/>
        <field name="balance"/>
      </list>
    </field>
  </record>

  <record id="view_move_line_search" model="ir.ui.view">
    <field name="name">account.move.line.search</field>
    <field name="model">account.move.line</field>
    <field name="arch" type="xml">
      <search string="Journal Items">
        <field name="name"/>
        <field name="move_name"/>
        <field name="account_id"/>
        <field name="partner_id"/>
        <filter name="posted" string="Posted" domain="[('parent_state', '=', 'posted')]"/>
        <filter name="unposted" string="Unposted" domain="[('parent_state', '!=', 'posted')]"/>
        <group>
          <filter name="groupby_account" string="Account" context="{'group_by': 'account_id'}"/>
          <filter name="groupby_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
          <filter name="groupby_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_account_moves_all" model="ir.actions.act_window">
    <field name="name">Journal Items</field>
    <field name="res_model">account.move.line</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_move_line_list"/>
    <field name="search_view_id" ref="view_move_line_search"/>
  </record>
  <record id="action_account_moves_all_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_account_moves_all"/>
    <field name="view_id" ref="view_move_line_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_account_moves_all_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_account_moves_all"/>
    <field name="view_id" ref="view_move_line_readonly_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <menuitem id="menu_finance_entries" name="Accounting" parent="menu_finance" sequence="40">
    <menuitem id="menu_action_move_journal_line" name="Journal Entries" action="action_move_journal_line" sequence="10"/>
    <menuitem id="menu_action_account_moves_all" name="Journal Items" action="action_account_moves_all" sequence="20"/>
  </menuitem>

  <record id="menu_finance_entries" model="ir.ui.menu"><field name="web_icon">lucide:book-open</field></record>
  <record id="menu_action_move_journal_line" model="ir.ui.menu"><field name="web_icon">lucide:notebook-text</field></record>
  <record id="menu_action_account_moves_all" model="ir.ui.menu"><field name="web_icon">lucide:list</field></record>
</erp>
