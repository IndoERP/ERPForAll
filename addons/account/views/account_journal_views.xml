<!-- Journals and journal groups (ledgers), Accounting > Configuration. -->
<erp>
  <record id="view_account_journal_list" model="ir.ui.view">
    <field name="name">account.journal.list</field>
    <field name="model">account.journal</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="code"/>
        <field name="type"/>
        <field name="journal_group_id"/>
        <field name="default_account_id"/>
        <field name="currency_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>

  <record id="view_account_journal_form" model="ir.ui.view">
    <field name="name">account.journal.form</field>
    <field name="model">account.journal</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="type"/>
              <field name="code"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="currency_id"/>
              <field name="journal_group_id"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Journal Entries" name="entries">
              <group>
                <group string="Accounting Information">
                  <field name="default_account_id"/>
                  <field name="suspense_account_id" invisible="type not in ('bank', 'cash', 'credit')"/>
                  <field name="profit_account_id" invisible="type not in ('bank', 'cash')"/>
                  <field name="loss_account_id" invisible="type not in ('bank', 'cash')"/>
                </group>
                <group string="Entry Numbers">
                  <field name="sequence_reset"/>
                  <field name="sequence_padding"/>
                  <field name="refund_sequence" invisible="type not in ('sale', 'purchase')"/>
                  <field name="payment_sequence" invisible="type not in ('bank', 'cash', 'credit')"/>
                </group>
              </group>
            </page>
            <page string="Dashboard" name="dashboard">
              <group>
                <field name="show_on_dashboard"/>
                <field name="color"/>
                <field name="sequence"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_journal_search" model="ir.ui.view">
    <field name="name">account.journal.search</field>
    <field name="model">account.journal</field>
    <field name="arch" type="xml">
      <search string="Journals">
        <field name="name"/>
        <field name="code"/>
        <filter name="sales" string="Sales" domain="[('type', '=', 'sale')]"/>
        <filter name="purchases" string="Purchases" domain="[('type', '=', 'purchase')]"/>
        <filter name="liquidity" string="Liquidity" domain="[('type', 'in', ('bank', 'cash', 'credit'))]"/>
        <filter name="miscellaneous" string="Miscellaneous" domain="[('type', '=', 'general')]"/>
        <separator/>
        <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
        <group>
          <filter name="groupby_type" string="Type" context="{'group_by': 'type'}"/>
          <filter name="groupby_company" string="Company" context="{'group_by': 'company_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_account_journal_form" model="ir.actions.act_window">
    <field name="name">Journals</field>
    <field name="res_model">account.journal</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_journal_list"/>
    <field name="search_view_id" ref="view_account_journal_search"/>
  </record>

  <record id="view_account_journal_group_list" model="ir.ui.view">
    <field name="name">account.journal.group.list</field>
    <field name="model">account.journal.group</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="view_account_journal_group_form" model="ir.ui.view">
    <field name="name">account.journal.group.form</field>
    <field name="model">account.journal.group</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
          </group>
          <field name="included_journal_ids"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_account_journal_group_list" model="ir.actions.act_window">
    <field name="name">Ledgers</field>
    <field name="res_model">account.journal.group</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_journal_group_list"/>
  </record>
</erp>
