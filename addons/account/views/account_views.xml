<erp>
  <record id="view_account_list" model="ir.ui.view">
    <field name="name">account.account.list</field>
    <field name="model">account.account</field>
    <field name="arch" type="xml">
      <list>
        <field name="code"/>
        <field name="name"/>
        <field name="account_type"/>
        <field name="reconcile"/>
        <field name="currency_id"/>
      </list>
    </field>
  </record>

  <record id="view_account_form" model="ir.ui.view">
    <field name="name">account.account.form</field>
    <field name="model">account.account</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="account_type"/>
              <field name="reconcile"/>
              <field name="non_trade"/>
              <field name="currency_id"/>
            </group>
            <group>
              <field name="company_ids" widget="many2many_tags"/>
              <field name="tag_ids" widget="many2many_tags"/>
              <field name="parent_id"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Codes by company" name="code_mapping">
              <field name="code_mapping_ids"/>
            </page>
            <page string="Notes" name="notes">
              <field name="description"/>
              <field name="note"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_search" model="ir.ui.view">
    <field name="name">account.account.search</field>
    <field name="model">account.account</field>
    <field name="arch" type="xml">
      <search string="Accounts">
        <field name="name"/>
        <field name="tag_ids"/>
        <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
        <group>
          <filter name="groupby_type" string="Type" context="{'group_by': 'account_type'}"/>
          <filter name="groupby_group" string="Internal Group" context="{'group_by': 'internal_group'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_account_form" model="ir.actions.act_window">
    <field name="name">Chart of Accounts</field>
    <field name="res_model">account.account</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_list"/>
    <field name="search_view_id" ref="view_account_search"/>
  </record>

  <record id="view_account_code_mapping_list" model="ir.ui.view">
    <field name="name">account.code.mapping.list</field>
    <field name="model">account.code.mapping</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="company_id"/>
        <field name="code"/>
      </list>
    </field>
  </record>

  <record id="view_account_tag_list" model="ir.ui.view">
    <field name="name">account.account.tag.list</field>
    <field name="model">account.account.tag</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="applicability"/>
        <field name="country_id"/>
      </list>
    </field>
  </record>

  <record id="view_account_tag_form" model="ir.ui.view">
    <field name="name">account.account.tag.form</field>
    <field name="model">account.account.tag</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <group>
            <field name="name"/>
            <field name="applicability"/>
            <field name="country_id"/>
            <field name="color"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_account_tag" model="ir.actions.act_window">
    <field name="name">Account Tags</field>
    <field name="res_model">account.account.tag</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_tag_list"/>
  </record>

  <!--
Fiscal periods: read-only; rows come from ensure_periods and change only
       through the lock operations. 
  -->
  <record id="view_account_fiscal_period_list" model="ir.ui.view">
    <field name="name">account.fiscal.period.list</field>
    <field name="model">account.fiscal.period</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="company_id"/>
        <field name="name"/>
        <field name="kind"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="status"/>
        <field name="stock_lock_status"/>
      </list>
    </field>
  </record>

  <record id="view_account_fiscal_period_form" model="ir.ui.view">
    <field name="name">account.fiscal.period.form</field>
    <field name="model">account.fiscal.period</field>
    <field name="arch" type="xml">
      <form record_mode="record" create="false" edit="false" delete="false">
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="company_id"/>
              <field name="fiscal_year"/>
              <field name="kind"/>
              <field name="number"/>
              <field name="date_from"/>
              <field name="date_to"/>
            </group>
            <group>
              <field name="status"/>
              <field name="closed_at"/>
              <field name="hard_locked_at"/>
              <field name="hard_lock_started_by"/>
              <field name="hard_lock_started_at"/>
              <field name="stock_lock_status"/>
              <field name="stock_lock_started_by"/>
              <field name="stock_lock_started_at"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_fiscal_period_search" model="ir.ui.view">
    <field name="name">account.fiscal.period.search</field>
    <field name="model">account.fiscal.period</field>
    <field name="arch" type="xml">
      <search string="Fiscal Periods">
        <field name="name"/>
        <field name="company_id"/>
        <field name="fiscal_year"/>
        <filter name="open" string="Open" domain="[('status', '=', 'open')]"/>
        <filter name="locked" string="Locked" domain="[('status', '!=', 'open')]"/>
        <filter name="stock_locked" string="Stock locked" domain="[('stock_lock_status', '!=', 'open')]"/>
        <group>
          <filter name="groupby_company" string="Company" context="{'group_by': 'company_id'}"/>
          <filter name="groupby_year" string="Fiscal Year" context="{'group_by': 'fiscal_year'}"/>
          <filter name="groupby_status" string="Status" context="{'group_by': 'status'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_account_fiscal_period" model="ir.actions.act_window">
    <field name="name">Fiscal Periods</field>
    <field name="res_model">account.fiscal.period</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_fiscal_period_list"/>
    <field name="search_view_id" ref="view_account_fiscal_period_search"/>
  </record>
</erp>
