<!-- Customer invoices, vendor bills and their credit notes: Accounting > Customers and Accounting > Vendors. -->
<erp>
  <record id="view_invoice_list" model="ir.ui.view">
    <field name="name">account.move.invoice.list</field>
    <field name="model">account.move</field>
    <field name="priority" eval="20"/>
    <field name="arch" type="xml">
      <list>
        <dashboard>
          <count name="draft" string="Draft" filter="draft" color="info"/>
          <count name="posted" string="Posted" filter="posted" color="success"/>
          <count name="unpaid" string="Unpaid" filter="unpaid" color="warning"/>
        </dashboard>
        <field name="name" string="Number"/>
        <field name="partner_id"/>
        <field name="invoice_date"/>
        <field name="invoice_date_due"/>
        <field name="amount_untaxed"/>
        <field name="amount_total"/>
        <field name="amount_residual"/>
        <field name="currency_id"/>
        <field name="state" widget="badge" options="{'tone_success': ['posted'], 'tone_warning': ['draft'], 'tone_danger': ['cancel']}"/>
        <field name="payment_state" widget="badge" options="{'tone_success': ['in_payment', 'paid'], 'tone_warning': ['not_paid', 'partial']}"/>
      </list>
    </field>
  </record>

  <!-- The product lines of an invoice: what was sold or bought, never the debit and credit of the journal item. -->
  <record id="view_invoice_line_list" model="ir.ui.view">
    <field name="name">account.move.line.invoice.list</field>
    <field name="model">account.move.line</field>
    <field name="priority" eval="20"/>
    <field name="arch" type="xml">
      <list>
        <field name="product_id"/>
        <field name="name"/>
        <field name="account_id"/>
        <field name="analytic_account_id" groups="account.group_cost_center_controlling"/>
        <field name="quantity"/>
        <field name="product_uom_id"/>
        <field name="price_unit"/>
        <field name="discount" string="Disc. %"/>
        <field name="tax_ids" widget="many2many_tags"/>
        <field name="currency_id" invisible="1"/>
        <field name="price_subtotal"/>
      </list>
    </field>
  </record>
  <record id="view_invoice_line_form" model="ir.ui.view">
    <field name="name">account.move.line.invoice.form</field>
    <field name="model">account.move.line</field>
    <field name="priority" eval="20"/>
    <field name="arch" type="xml">
      <form string="Invoice Line">
        <sheet>
          <!-- a line of a posted or cancelled invoice keeps only its label editable -->
          <field name="parent_state" invisible="1"/>
          <group>
            <group>
              <field name="product_id" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="name"/>
              <field name="account_id" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="analytic_account_id" groups="account.group_cost_center_controlling" readonly="parent_state in ('posted', 'cancel')"/>
            </group>
            <group>
              <field name="quantity" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="product_uom_id" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="price_unit" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="discount" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="tax_ids" widget="many2many_tags" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="currency_id" invisible="1" readonly="parent_state in ('posted', 'cancel')"/>
              <field name="price_subtotal" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_invoice_form" model="ir.ui.view">
    <field name="name">account.move.invoice.form</field>
    <field name="model">account.move</field>
    <field name="priority" eval="20"/>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_post" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_register_payment" type="object" string="Register Payment" class="btn-primary"
                  invisible="state != 'posted' or payment_state not in ('not_paid', 'partial')"/>
          <button name="action_open_reversal_wizard" type="object" string="Credit Note"
                  invisible="state != 'posted' or move_type not in ('out_invoice', 'in_invoice')"/>
          <!-- a posted invoice is corrected by a reversal: only a cancelled one without matched
               items or payments returns to draft, the server's reset_blocked -->
          <button name="button_draft" type="object" string="Reset to Draft" invisible="reset_blocked"/>
          <button name="button_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_payments" type="object" class="oe_stat_button" icon="lucide:banknote" invisible="payment_count == 0">
              <field name="payment_count" widget="statinfo" string="Payments"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Paid" bg_color="bg-success" invisible="state != 'posted' or payment_state != 'paid'"/>
          <widget name="web_ribbon" title="In Payment" bg_color="bg-success" invisible="state != 'posted' or payment_state != 'in_payment'"/>
          <widget name="web_ribbon" title="Partial" bg_color="bg-warning" invisible="state != 'posted' or payment_state != 'partial'"/>
          <widget name="web_ribbon" title="Reversed" bg_color="bg-info" invisible="state != 'posted' or payment_state != 'reversed'"/>
          <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancel'"/>
          <field name="reset_blocked" invisible="1"/>
          <div class="oe_title">
            <field name="move_type" invisible="1" readonly="state != 'draft'"/>
            <h1><field name="name" readonly="1" invisible="not name"/><field name="display_name" readonly="1" invisible="name"/></h1>
          </div>
          <group>
            <group>
              <field name="partner_id" string="Customer" readonly="state != 'draft'" invisible="move_type not in ('out_invoice', 'out_refund')"/>
              <field name="partner_id" string="Vendor" readonly="state != 'draft'" invisible="move_type not in ('in_invoice', 'in_refund')"/>
              <field name="ref"/>
            </group>
            <group>
              <field name="invoice_date" string="Invoice Date" readonly="state != 'draft'" invisible="move_type not in ('out_invoice', 'out_refund')"/>
              <field name="invoice_date" string="Bill Date" readonly="state != 'draft'" invisible="move_type not in ('in_invoice', 'in_refund')"/>
              <field name="invoice_date_due" readonly="state != 'draft'"/>
              <field name="invoice_payment_term_id" readonly="state != 'draft'"/>
              <field name="journal_id" readonly="state != 'draft'"/>
              <field name="currency_id" readonly="state != 'draft'"/>
            </group>
          </group>
          <notebook>
            <page string="Invoice Lines" name="invoice_lines">
              <field name="invoice_line_ids" readonly="state != 'draft'"
                     context="{'list_view_ref': 'account.view_invoice_line_list', 'form_view_ref': 'account.view_invoice_line_form'}"/>
              <group name="totals">
                <group/>
                <group string="Totals">
                  <field name="amount_untaxed"/>
                  <field name="amount_tax"/>
                  <field name="amount_total"/>
                  <field name="amount_residual"/>
                </group>
              </group>
            </page>
            <page string="Journal Items" name="journal_items">
              <field name="line_ids" readonly="1"/>
            </page>
            <page string="Other Info" name="other_info">
              <group>
                <group>
                  <field name="payment_state" readonly="1"/>
                </group>
                <group>
                  <field name="company_id" readonly="1"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_invoice_search" model="ir.ui.view">
    <field name="name">account.move.invoice.search</field>
    <field name="model">account.move</field>
    <field name="priority" eval="20"/>
    <field name="arch" type="xml">
      <search string="Invoices">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="ref"/>
        <field name="journal_id"/>
        <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
        <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
        <separator/>
        <filter name="unpaid" string="Unpaid" domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
        <group>
          <filter name="groupby_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
          <filter name="groupby_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
          <filter name="groupby_invoice_date" string="Invoice Date" context="{'group_by': 'invoice_date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_move_out_invoice_type" model="ir.actions.act_window">
    <field name="name">Invoices</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="search_view_id" ref="view_invoice_search"/>
    <field name="domain">[('move_type', '=', 'out_invoice')]</field>
    <field name="context">{'default_move_type': 'out_invoice'}</field>
  </record>
  <record id="action_move_out_invoice_type_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_out_invoice_type"/>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_move_out_invoice_type_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_out_invoice_type"/>
    <field name="view_id" ref="view_invoice_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <record id="action_move_out_refund_type" model="ir.actions.act_window">
    <field name="name">Credit Notes</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="search_view_id" ref="view_invoice_search"/>
    <field name="domain">[('move_type', '=', 'out_refund')]</field>
    <field name="context">{'default_move_type': 'out_refund'}</field>
  </record>
  <record id="action_move_out_refund_type_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_out_refund_type"/>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_move_out_refund_type_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_out_refund_type"/>
    <field name="view_id" ref="view_invoice_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <record id="action_move_in_invoice_type" model="ir.actions.act_window">
    <field name="name">Bills</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="search_view_id" ref="view_invoice_search"/>
    <field name="domain">[('move_type', '=', 'in_invoice')]</field>
    <field name="context">{'default_move_type': 'in_invoice'}</field>
  </record>
  <record id="action_move_in_invoice_type_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_in_invoice_type"/>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_move_in_invoice_type_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_in_invoice_type"/>
    <field name="view_id" ref="view_invoice_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <record id="action_move_in_refund_type" model="ir.actions.act_window">
    <field name="name">Refunds</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="search_view_id" ref="view_invoice_search"/>
    <field name="domain">[('move_type', '=', 'in_refund')]</field>
    <field name="context">{'default_move_type': 'in_refund'}</field>
  </record>
  <record id="action_move_in_refund_type_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_in_refund_type"/>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_move_in_refund_type_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_in_refund_type"/>
    <field name="view_id" ref="view_invoice_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <!-- The lists a dashboard figure opens: every document of one journal, whatever its type. They have no domain
       of their own (the figure gives the journal) and no menu. -->
  <record id="action_move_out_documents" model="ir.actions.act_window">
    <field name="name">Invoices and Credit Notes</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="search_view_id" ref="view_invoice_search"/>
    <field name="context">{'default_move_type': 'out_invoice'}</field>
  </record>
  <record id="action_move_out_documents_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_out_documents"/>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_move_out_documents_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_out_documents"/>
    <field name="view_id" ref="view_invoice_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <record id="action_move_in_documents" model="ir.actions.act_window">
    <field name="name">Bills and Refunds</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="search_view_id" ref="view_invoice_search"/>
    <field name="context">{'default_move_type': 'in_invoice'}</field>
  </record>
  <record id="action_move_in_documents_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_in_documents"/>
    <field name="view_id" ref="view_invoice_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_move_in_documents_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_move_in_documents"/>
    <field name="view_id" ref="view_invoice_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>

  <menuitem id="menu_finance_receivables" name="Customers" parent="menu_finance" sequence="20">
    <menuitem id="menu_action_move_out_invoice_type" name="Invoices" action="action_move_out_invoice_type" sequence="10"/>
    <menuitem id="menu_action_move_out_refund_type" name="Credit Notes" action="action_move_out_refund_type" sequence="20"/>
  </menuitem>
  <menuitem id="menu_finance_payables" name="Vendors" parent="menu_finance" sequence="30">
    <menuitem id="menu_action_move_in_invoice_type" name="Bills" action="action_move_in_invoice_type" sequence="10"/>
    <menuitem id="menu_action_move_in_refund_type" name="Refunds" action="action_move_in_refund_type" sequence="20"/>
  </menuitem>

  <record id="menu_finance_receivables" model="ir.ui.menu"><field name="web_icon">lucide:contact</field></record>
  <record id="menu_action_move_out_invoice_type" model="ir.ui.menu"><field name="web_icon">lucide:receipt-text</field></record>
  <record id="menu_action_move_out_refund_type" model="ir.ui.menu"><field name="web_icon">lucide:undo-2</field></record>
  <record id="menu_finance_payables" model="ir.ui.menu"><field name="web_icon">lucide:handshake</field></record>
  <record id="menu_action_move_in_invoice_type" model="ir.ui.menu"><field name="web_icon">lucide:receipt-text</field></record>
  <record id="menu_action_move_in_refund_type" model="ir.ui.menu"><field name="web_icon">lucide:undo-2</field></record>
  <record id="view_account_move_reversal_form" model="ir.ui.view">
    <field name="name">account.move.reversal.form</field>
    <field name="model">account.move.reversal</field>
    <field name="arch" type="xml">
      <form string="Credit Note" record_mode="record">
        <group>
          <group>
            <field name="move_id" readonly="1"/>
            <field name="refund_method"/>
            <field name="reason" placeholder="e.g. Returned goods or billing correction"/>
          </group>
          <group>
            <field name="date"/>
            <field name="journal_id"/>
            <field name="company_id" invisible="1"/>
          </group>
        </group>
        <footer>
          <button name="reverse_moves" type="object" string="Reverse" class="btn-primary"/>
          <button special="cancel" string="Cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="res_partner_form_account_invoices_button" model="ir.ui.view">
    <field name="name">res.partner.form.account.invoices.button</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_partner_invoices" type="object" class="oe_stat_button" icon="lucide:receipt-text"
                groups="account.group_account_user" invisible="invoice_count == 0">
          <field name="invoice_count" widget="statinfo" string="Invoices"/>
        </button>
      </xpath>
    </field>
  </record>
</erp>
