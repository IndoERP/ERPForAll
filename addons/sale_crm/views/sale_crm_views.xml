<erp>
  <record id="lead_sales_form" model="ir.ui.view">
    <field name="name">crm.lead.form.sales</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.lead_form"/>
    <field name="arch" type="xml">
      <xpath expr="/form/header" position="inside">
        <button name="action_create_quotation" type="object" string="Create Quotation"
                groups="sales_team.group_sale_salesman" invisible="kind != 'opportunity' or state == 'lost' or not partner_id"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_quotations" type="object" class="oe_stat_button" icon="lucide:receipt-text"
                invisible="kind != 'opportunity' or quotation_count == 0">
          <field name="quotation_count" widget="statinfo" string="Sales Documents"/>
        </button>
      </xpath>
    </field>
  </record>
  <record id="sale_order_opportunity_form" model="ir.ui.view">
    <field name="name">sale.order.form.opportunity</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <field name="team_id" position="after">
        <field name="opportunity_id" readonly="state not in ('draft', 'sent') or locked"
               domain="[('kind', '=', 'opportunity'), ('state', '!=', 'lost'), ('partner_id', '=', partner_id), ('company_id', '=', company_id)]"
               options="{'no_create': True}"/>
      </field>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_opportunity" type="object" class="oe_stat_button" icon="lucide:briefcase"
                invisible="opportunity_count == 0">
          <field name="opportunity_count" widget="statinfo" string="Opportunity"/>
        </button>
      </xpath>
    </field>
  </record>
  <record id="booking_list" model="ir.ui.view">
    <field name="name">sale.order.crm.booking.list</field>
    <field name="model">sale.order</field>
    <field name="priority" eval="99"/>
    <field name="arch" type="xml">
      <list string="Confirmed Bookings" create="0" edit="0" delete="0">
        <field name="name"/><field name="opportunity_id"/><field name="partner_id"/>
        <field name="date_order"/><field name="user_id"/><field name="team_id"/>
        <field name="company_id"/><field name="crm_booking_amount"/><field name="crm_booking_currency_id"/>
      </list>
    </field>
  </record>
  <record id="action_bookings" model="ir.actions.act_window">
    <field name="name">Confirmed Bookings</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="booking_list"/>
    <field name="domain">[('state', '=', 'sale'), ('opportunity_id', '!=', False)]</field>
  </record>
  <menuitem id="menu_bookings" name="Confirmed Bookings" parent="crm.menu_reporting"
            action="action_bookings" groups="sales_team.group_sale_salesman" sequence="70"/>
</erp>
