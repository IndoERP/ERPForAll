<?xml version="1.0" encoding="utf-8"?>
<erp>
  <record id="lead_board" model="ir.ui.view">
    <field name="name">crm.lead.pipeline</field>
    <field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <kanban string="Pipeline" default_group_by="stage_id" group_scope="pipeline_id" records_draggable="1" quick_create="0">
        <templates><t t-name="card">
          <main><field name="name"/><field name="partner_id"/><field name="expected_revenue"/><field name="currency_id" invisible="1"/></main>
          <aside><field name="user_id" widget="many2one_avatar"/></aside>
          <footer><field name="next_activity_date"/><field name="date_deadline"/><field name="forecast_category" widget="badge"/></footer>
        </t></templates>
      </kanban>
    </field>
  </record>
  <record id="lead_list" model="ir.ui.view">
    <field name="name">crm.lead.list</field><field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <list string="Leads and Opportunities">
        <field name="name" width="[200px]"/><field name="partner_id"/><field name="stage_id"/>
        <field name="expected_revenue"/><field name="currency_id" invisible="1"/>
        <field name="next_activity_date"/><field name="date_deadline"/><field name="user_id" widget="many2one_avatar"/>
        <field name="state" widget="badge" options="{'tone_success':['won'],'tone_muted':['lost']}"/>
      </list>
    </field>
  </record>
  <record id="lead_queue_list" model="ir.ui.view">
    <field name="name">crm.lead.queue.list</field><field name="model">crm.lead</field><field name="priority" eval="30"/>
    <field name="arch" type="xml">
      <list string="Lead Queue">
        <field name="name" width="[180px]"/><field name="company_name"/><field name="contact_name"/>
        <field name="source"/><field name="score"/><field name="team_id"/><field name="user_id" widget="many2one_avatar"/>
        <field name="next_activity_date"/>
      </list>
    </field>
  </record>
  <record id="lead_form" model="ir.ui.view">
    <field name="name">crm.lead.form</field><field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <form string="Sales Opportunity" edit_mode="read">
        <header>
          <button name="action_qualify" type="object" string="Qualify" class="btn-primary" invisible="kind != 'lead' or state != 'open'"/>
          <button name="action_claim" type="object" string="Assign to Me" invisible="user_id or state != 'open'"/>
          <button name="action_win" type="object" string="Mark Won" invisible="kind != 'opportunity' or state != 'open'"
                  prompt="text" prompt-label="Contract or reason for winning" prompt-required="1" prompt-max="500"/>
          <button name="action_lose" type="object" string="Mark Lost" invisible="state != 'open'"
                  prompt="text" prompt-label="Reason for losing" prompt-required="1" prompt-max="500"/>
          <button name="action_reopen" type="object" string="Reopen" invisible="state == 'open'" confirm="Return this record to the open pipeline?"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div name="button_box" class="oe_button_box"/>
          <div class="oe_title"><h1><field name="name" placeholder="Opportunity or lead name"/></h1></div>
          <group>
            <group string="Customer and ownership">
              <field name="partner_id"/><field name="company_name" invisible="kind != 'lead'"/>
              <field name="contact_name" invisible="kind != 'lead'"/>
              <field name="email" widget="email" invisible="kind != 'lead'"/><field name="phone" widget="phone" invisible="kind != 'lead'"/>
              <field name="team_id"/><field name="user_id" widget="many2one_avatar" readonly="1" force_save="1"/>
              <field name="salesperson_member_id" groups="sales_team.group_sale_salesman_all_leads"
                     domain="[('active','=',True),('crm_team_id','=',team_id)]" options="{'no_create': True}" invisible="not team_id or state != 'open'"/>
            </group>
            <group string="Deal outlook">
              <field name="pipeline_id"/><field name="stage_id" domain="[('pipeline_id', '=', pipeline_id)]"/>
              <field name="deal_currency_id"/><field name="deal_amount"/><field name="date_deadline"/>
              <field name="next_step"/><field name="next_activity_date" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page name="forecast" string="Forecast">
              <group>
                <group string="Forecast"><field name="forecast_category"/><field name="probability"/>
                  <field name="expected_revenue" readonly="1"/><field name="weighted_revenue" readonly="1"/><field name="currency_id" readonly="1"/></group>
              </group>
            </page>
            <page name="outcome" string="Outcome" invisible="state == 'open'">
              <group>
                <group string="Resolution"><field name="closed_date" readonly="1"/><field name="close_reason" readonly="1"/></group>
                <group><field name="won_amount" invisible="state != 'won'" readonly="1"/><field name="won_currency_id" invisible="1"/>
                  <field name="won_rate" invisible="state != 'won'" readonly="1"/></group>
              </group>
            </page>
            <page name="contacts" string="Contact Roles"><field name="contact_role_ids" nolabel="1"/></page>
            <page name="qualification" string="Qualification">
              <group>
                <group string="Lead source"><field name="source"/><field name="region"/><field name="tag_ids" widget="many2many_tags"/></group>
                <group string="Lead score"><field name="score" readonly="1"/><field name="score_reasons" readonly="1"/></group>
              </group>
            </page>
            <page name="history" string="Stage History"><field name="history_ids" readonly="1" nolabel="1"/></page>
            <page name="record" string="Record"><group><field name="company_id"/><field name="kind" readonly="1"/><field name="stage_since" readonly="1"/></group></page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="lead_activity" model="ir.ui.view">
    <field name="name">crm.lead.activity</field><field name="model">crm.lead</field>
    <field name="arch" type="xml"><activity string="Sales Activities"><field name="name"/><field name="partner_id"/><field name="user_id"/></activity></field>
  </record>
  <record id="lead_search" model="ir.ui.view">
    <field name="name">crm.lead.search</field><field name="model">crm.lead</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/><field name="partner_id"/><field name="team_id"/><field name="user_id"/><field name="source"/>
        <filter name="mine" string="My Pipeline" domain="[('user_id','=',uid)]"/>
        <filter name="unassigned" string="Unassigned" domain="[('user_id','=',False)]"/>
        <separator/>
        <filter name="overdue" string="Overdue Activity" domain="[('state','=','open'),('next_activity_date','&lt;','today')]"/>
        <filter name="no_followup" string="No Scheduled Activity" domain="[('state','=','open'),('next_activity_date','=',False)]"/>
        <separator/>
        <filter name="closing_month" string="Closing This Month" domain="[('date_deadline','&gt;=','today =1d'),('date_deadline','&lt;','today =1d +1m')]"/>
        <group>
          <filter name="by_team" string="Sales Team" context="{'group_by':'team_id'}"/>
          <filter name="by_owner" string="Salesperson" context="{'group_by':'user_id'}"/>
          <filter name="by_stage" string="Stage" context="{'group_by':'stage_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="pipeline_window" model="ir.actions.act_window">
    <field name="name">Pipeline</field><field name="res_model">crm.lead</field><field name="view_mode">kanban,list,form,activity</field>
    <field name="view_id" ref="lead_board"/><field name="search_view_id" ref="lead_search"/>
    <field name="domain">[('kind','=','opportunity'),('state','=','open')]</field><field name="context">{'default_kind':'opportunity'}</field>
  </record>
  <record id="lead_window" model="ir.actions.act_window">
    <field name="name">Leads</field><field name="res_model">crm.lead</field><field name="view_mode">list,form,activity</field>
    <field name="view_id" ref="lead_queue_list"/><field name="search_view_id" ref="lead_search"/>
    <field name="domain">[('kind','=','lead'),('state','=','open')]</field><field name="context">{'default_kind':'lead'}</field>
  </record>
  <record id="opportunity_window" model="ir.actions.act_window">
    <field name="name">All Opportunities</field><field name="res_model">crm.lead</field><field name="view_mode">list,form,activity</field>
    <field name="view_id" ref="lead_list"/><field name="search_view_id" ref="lead_search"/>
    <field name="domain">[('kind','=','opportunity')]</field><field name="context">{'default_kind':'opportunity'}</field>
  </record>
  <record id="partner_opportunity_button" model="ir.ui.view">
    <field name="name">res.partner.form.opportunities</field><field name="model">res.partner</field><field name="inherit_id" ref="base.partner_form"/>
    <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside">
      <button name="action_view_crm_opportunities" type="object" class="oe_stat_button" icon="lucide:target" groups="sales_team.group_sale_salesman">
        <field name="crm_opportunity_count" widget="statinfo" string="Opportunities"/>
      </button>
    </xpath></field>
  </record>
  <record id="partner_business_account" model="ir.ui.view">
    <field name="name">res.partner.form.business.account</field><field name="model">res.partner</field>
    <field name="inherit_id" ref="base.partner_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='industry_id']" position="after">
      <field name="crm_is_business" string="Business Account" groups="sales_team.group_sale_salesman" invisible="is_company"/>
    </xpath></field>
  </record>
  <record id="account_window" model="ir.actions.act_window">
    <field name="name">Business Accounts</field><field name="res_model">res.partner</field>
    <field name="view_mode">list,kanban,form</field><field name="view_id" ref="base.partner_list"/>
    <field name="search_view_id" ref="base.partner_search"/>
    <field name="domain">['|',('is_company','=',True),('crm_is_business','=',True)]</field>
    <field name="context">{'default_crm_is_business':True}</field>
  </record>
  <record id="pipeline_graph" model="ir.ui.view">
    <field name="name">crm.lead.graph</field><field name="model">crm.lead</field>
    <field name="arch" type="xml"><graph string="Opportunity Volume" type="bar">
      <field name="stage_id"/><field name="state"/>
    </graph></field>
  </record>
  <record id="pipeline_pivot" model="ir.ui.view">
    <field name="name">crm.lead.pivot</field><field name="model">crm.lead</field>
    <field name="arch" type="xml"><pivot string="Opportunity Volume" display_quantity="1">
      <field name="pipeline_id" type="row"/><field name="stage_id" type="row"/><field name="state" type="col"/>
    </pivot></field>
  </record>
  <record id="pipeline_analysis_window" model="ir.actions.act_window">
    <field name="name">Pipeline Analysis</field><field name="res_model">crm.lead</field>
    <field name="view_mode">graph,pivot,list,form</field><field name="view_id" ref="pipeline_graph"/>
    <field name="search_view_id" ref="lead_search"/><field name="domain">[('kind','=','opportunity')]</field>
    <field name="context">{'default_kind':'opportunity'}</field>
  </record>
  <record id="lost_list" model="ir.ui.view">
    <field name="name">crm.lead.lost.list</field><field name="model">crm.lead</field><field name="priority" eval="40"/>
    <field name="arch" type="xml"><list string="Lost Opportunities" create="0">
      <field name="name"/><field name="partner_id"/><field name="closed_date"/><field name="stage_id"/>
      <field name="close_reason"/><field name="user_id"/>
    </list></field>
  </record>
  <record id="loss_window" model="ir.actions.act_window">
    <field name="name">Lost Opportunities</field><field name="res_model">crm.lead</field><field name="view_mode">list,form</field>
    <field name="domain">[('kind','=','opportunity'),('state','=','lost')]</field><field name="search_view_id" ref="lead_search"/>
    <field name="view_id" ref="lost_list"/>
  </record>
</erp>
