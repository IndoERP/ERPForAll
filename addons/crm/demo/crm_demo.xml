<!-- Demo CRM assignment/scoring rules, leads, opportunities across all stages, and stakeholder contact roles.
     No demo users are referenced: ERPForAll demo data never ships user accounts or credentials. -->
<erp noupdate="1">
  <!-- Lead assignment and scoring rules. -->
  <record id="rule_demo_enterprise_referral" model="crm.rule">
    <field name="name">Referral Korporat</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="sequence">10</field>
    <field name="source">Referral</field>
    <field name="team_id" ref="sales_team.team_demo_corporate"/>
    <field name="points">35</field>
  </record>
  <record id="rule_demo_website_jabodetabek" model="crm.rule">
    <field name="name">Website Jabodetabek</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="sequence">20</field>
    <field name="source">Website</field>
    <field name="region">Jabodetabek</field>
    <field name="team_id" ref="sales_team.team_demo_online"/>
    <field name="points">25</field>
  </record>
  <record id="rule_demo_exhibition" model="crm.rule">
    <field name="name">Pameran Industri</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="sequence">30</field>
    <field name="source">Pameran</field>
    <field name="team_id" ref="sales_team.team_demo_corporate"/>
    <field name="points">20</field>
  </record>

  <!-- Open leads in the Lead Queue (scored and routed by the rules above). -->
  <record id="lead_demo_bintang_logistik" model="crm.lead">
    <field name="name">Integrasi Gudang &amp; Distribusi</field>
    <field name="kind">lead</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="pipeline_id" ref="pipeline_direct"/>
    <field name="stage_id" ref="stage_prospect"/>
    <field name="company_name">PT Bintang Logistik Pratama</field>
    <field name="contact_name">Rudi Hartono</field>
    <field name="email">rudi@bintang-logistik.example</field>
    <field name="phone">+62 21 555 0301</field>
    <field name="source">Referral</field>
    <field name="region">Jabodetabek</field>
    <field name="deal_amount">18500</field>
    <field name="next_step">Jadwalkan panggilan discovery kebutuhan multi-gudang</field>
    <field name="tag_ids" eval="[(6, 0, [ref('sales_team.tag_demo_b2b'), ref('sales_team.tag_demo_priority')])]"/>
  </record>
  <record id="lead_demo_surya_retail" model="crm.lead">
    <field name="name">Ekspansi POS 12 Gerai</field>
    <field name="kind">lead</field>
    <field name="company_id" ref="base.main_company"/>
