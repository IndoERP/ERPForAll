    <field name="phone">+62 22 555 0302</field>
    <field name="source">Website</field>
    <field name="region">Jawa Barat</field>
    <field name="deal_amount">9200</field>
    <field name="next_step">Kirim profil produk dan estimasi paket implementasi</field>
    <field name="tag_ids" eval="[(6, 0, [ref('sales_team.tag_demo_retail')])]"/>
  </record>
  <record id="lead_demo_nusantara_pangan" model="crm.lead">
    <field name="name">Pengadaan Bahan Baku &amp; Cold Chain</field>
    <field name="kind">lead</field>
    <field name="company_id" ref="base.main_company"/>
