<?xml version="1.0" encoding="utf-8"?>
<erp>
    <record id="author_list" model="ir.ui.view">
        <field name="name">sample_library.author.list</field>
        <field name="model">sample_library.author</field>
        <field name="arch" type="xml">
            <list string="Authors">
                <field name="name"/>
                <field name="country"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
            </list>
        </field>
    </record>
    <record id="author_form" model="ir.ui.view">
        <field name="name">sample_library.author.form</field>
        <field name="model">sample_library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="country"/>
                        <field name="email" widget="email"/>
                        <field name="phone" widget="phone"/>
                    </group>
                    <notebook>
                        <page name="books" string="Books">
                            <field name="book_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <aside>
                    <group string="Record information">
                        <field name="create_uid" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="write_uid" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </aside>
            </form>
        </field>
    </record>
    <record id="book_list" model="ir.ui.view">
        <field name="name">sample_library.book.list</field>
        <field name="model">sample_library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="favorite" widget="boolean_favorite"/>
                <field name="title"/>
                <field name="author_id"/>
                <field name="genre_ids" widget="many2many_tags"/>
                <field name="isbn"/>
                <field name="publication_year" options="{'enable_formatting': False}"/>
                <field name="pages"/>
                <field name="rating" widget="priority"/>
                <field name="book_format" widget="badge"/>
                <field name="member_discount" widget="percentage"/>
                <field name="cover_color" widget="color"/>
                <field name="website" widget="url"/>
                <field name="description" widget="html"/>
                <field name="available"/>
            </list>
        </field>
    </record>
    <record id="book_form" model="ir.ui.view">
        <field name="name">sample_library.book.form</field>
        <field name="model">sample_library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <div name="button_box" class="oe_button_box"/>
                    <div class="oe_title"><h1><field name="title"/></h1></div>
                    <group>
                        <group string="Book">
                            <field name="author_id"/>
                            <field name="isbn" widget="CopyClipboardChar"/>
                            <field name="website" widget="CopyClipboardURL"/>
                            <field name="book_format" widget="radio"/>
                            <field name="rating" widget="priority"/>
                            <field name="favorite" widget="boolean_favorite"/>
                        </group>
                        <group string="Catalogue">
                            <field name="publication_year" options="{'enable_formatting': False}"/>
                            <field name="published_on"/>
                            <field name="price"/>
                            <field name="genre_ids" widget="many2many_tags"/>
                            <field name="member_discount" widget="percentage"/>
                            <field name="cover_color" widget="color"/>
                            <field name="color" widget="color_picker"/>
                            <field name="available"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="summary" string="Summary">
                            <field name="summary" widget="CopyClipboardText"/>
                        </page>
                        <page name="description" string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page name="loans" string="Loans">
                            <field name="loan_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <aside>
                    <group string="Record information">
                        <field name="create_uid" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="write_uid" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </aside>
            </form>
        </field>
    </record>
    <record id="loan_list" model="ir.ui.view">
        <field name="name">sample_library.loan.list</field>
        <field name="model">sample_library.loan</field>
        <field name="arch" type="xml">
            <list string="Loans">
                <field name="book_id"/>
                <field name="borrower_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="loan_form" model="ir.ui.view">
        <field name="name">sample_library.loan.form</field>
        <field name="model">sample_library.loan</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Loan">
                            <field name="book_id"/>
                            <field name="borrower_id"/>
                            <field name="state"/>
                        </group>
                        <group string="Dates">
                            <field name="loan_date"/>
                            <field name="due_date"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                </sheet>
                <aside>
                    <group string="Record information">
                        <field name="create_uid" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="write_uid" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </aside>
            </form>
        </field>
    </record>
    <record id="genre_list" model="ir.ui.view">
        <field name="name">sample_library.genre.list</field>
        <field name="model">sample_library.genre</field>
        <field name="arch" type="xml">
            <list string="Genres">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="genre_form" model="ir.ui.view">
        <field name="name">sample_library.genre.form</field>
        <field name="model">sample_library.genre</field>
        <field name="arch" type="xml">
            <form string="Genre">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                </sheet>
                <aside>
                    <group string="Record information">
                        <field name="create_uid" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="write_uid" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </aside>
            </form>
        </field>
    </record>
    <!-- Books by author, then by the year published (rows), and by format (columns): how many books, how many pages, what they cost.
         The pivot expands any header by any field, so a tester can add genre-free groupings such as the rating or the quarter. -->
    <record id="book_pivot" model="ir.ui.view">
        <field name="name">sample_library.book.pivot</field>
        <field name="model">sample_library.book</field>
        <field name="arch" type="xml">
            <pivot string="Books" display_quantity="1" default_order="pages desc">
                <field name="author_id" type="row"/>
                <field name="published_on" type="row" interval="year"/>
                <field name="book_format" type="col"/>
                <field name="pages" type="measure"/>
                <field name="price" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="author_action" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">sample_library.author</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">sample_library.book</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
    <record id="loan_action" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">sample_library.loan</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="genre_action" model="ir.actions.act_window">
        <field name="name">Genres</field>
        <field name="res_model">sample_library.genre</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="library_menu" name="Library" groups="base.group_user" sequence="70" web_icon="lucide:library">
        <menuitem id="book_menu" name="Books" action="book_action" sequence="10"/>
        <menuitem id="author_menu" name="Authors" action="author_action" sequence="20"/>
        <menuitem id="loan_menu" name="Loans" action="loan_action" sequence="30"/>
        <menuitem id="genre_menu" name="Genres" action="genre_action" sequence="40"/>
    </menuitem>
</erp>
