<?xml version="1.0" encoding="utf-8"?>
<erp>
    <!-- Genres: each book is filed under one or more (many2many). -->
    <record id="genre_demo_science_fiction" model="sample_library.genre">
        <field name="name">Science Fiction</field>
    </record>
    <record id="genre_demo_fantasy" model="sample_library.genre">
        <field name="name">Fantasy</field>
    </record>
    <record id="genre_demo_historical" model="sample_library.genre">
        <field name="name">Historical Fiction</field>
    </record>
    <record id="genre_demo_literary" model="sample_library.genre">
