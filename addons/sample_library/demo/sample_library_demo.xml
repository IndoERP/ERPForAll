        <field name="pages" eval="183"/>
        <field name="published_on">1968-11-01</field>
        <field name="price" eval="7.25"/>
        <field name="book_format">hardcover</field>
        <field name="description">&lt;p&gt;A young wizard named &lt;strong&gt;Ged&lt;/strong&gt; accidentally unleashes a shadow upon the world.&lt;/p&gt;</field>
        <field name="genre_ids" eval="[(4, ref('genre_demo_fantasy'), 0), (4, ref('genre_demo_young_adult'), 0)]"/>
    </record>
