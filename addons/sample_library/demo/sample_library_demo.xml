    </record>
    <record id="genre_demo_indonesian" model="sample_library.genre">
        <field name="name">Indonesian Literature</field>
    </record>
    <record id="genre_demo_young_adult" model="sample_library.genre">
        <field name="name">Young Adult</field>
    </record>

    <!-- Authors: each lists its books (one2many through book.author_id). -->
    <record id="author_demo_le_guin" model="sample_library.author">
        <field name="name">Ursula K. Le Guin</field>
        <field name="country">United States</field>
    </record>
    <record id="author_demo_pramoedya" model="sample_library.author">
        <field name="name">Pramoedya Ananta Toer</field>
        <field name="country">Indonesia</field>
        <field name="email">authors@example.org</field>
        <field name="phone">+62 21 555 0100</field>
    </record>
    <record id="author_demo_hirata" model="sample_library.author">
        <field name="name">Andrea Hirata</field>
        <field name="country">Indonesia</field>
    </record>
    <record id="author_demo_kurniawan" model="sample_library.author">
        <field name="name">Eka Kurniawan</field>
        <field name="country">Indonesia</field>
    </record>
    <record id="author_demo_herbert" model="sample_library.author">
        <field name="name">Frank Herbert</field>
        <field name="country">United States</field>
    </record>
    <record id="author_demo_asimov" model="sample_library.author">
        <field name="name">Isaac Asimov</field>
        <field name="country">United States</field>
