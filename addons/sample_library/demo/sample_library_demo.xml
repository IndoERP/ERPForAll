    <!-- Books. -->
    <record id="book_demo_dispossessed" model="sample_library.book">
        <field name="title">The Dispossessed</field>
        <field name="author_id" ref="author_demo_le_guin"/>
        <field name="isbn">9780061054884</field>
        <field name="publication_year" eval="1974"/>
        <field name="pages" eval="387"/>
        <field name="published_on">1974-05-01</field>
        <field name="price" eval="9.5"/>
        <field name="summary">A physicist travels between two worlds with opposite social orders.</field>
        <field name="description">&lt;p&gt;A physicist travels between two worlds with opposite social orders, exploring &lt;strong&gt;anarchism&lt;/strong&gt; and capitalism.&lt;/p&gt;</field>
        <field name="website">https://example.org/books/the-dispossessed</field>
        <field name="cover_color">#2f6f8f</field>
        <field name="color" eval="4"/>
        <field name="rating">3</field>
        <field name="book_format">hardcover</field>
        <field name="member_discount" eval="0.1"/>
        <field name="favorite" eval="True"/>
        <field name="genre_ids" eval="[(4, ref('genre_demo_science_fiction'), 0)]"/>
    </record>
    <record id="book_demo_earthsea" model="sample_library.book">
        <field name="title">A Wizard of Earthsea</field>
        <field name="author_id" ref="author_demo_le_guin"/>
