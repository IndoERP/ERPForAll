<!-- Tags: list and form, and the window action of the Configuration menu. -->
<erp>
  <record id="project_tags_view_list" model="ir.ui.view">
    <field name="name">project.tags.list</field>
    <field name="model">project.tags</field>
    <field name="arch" type="xml">
      <list string="Tags">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="project_tags_view_form" model="ir.ui.view">
    <field name="name">project.tags.form</field>
    <field name="model">project.tags</field>
    <field name="arch" type="xml">
      <form string="Tag">
        <sheet>
          <group>
            <field name="name"/>
            <field name="color" widget="color_picker"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="project_tags_action" model="ir.actions.act_window">
    <field name="name">Tags</field>
    <field name="res_model">project.tags</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="project_tags_view_list"/>
  </record>
</erp>
