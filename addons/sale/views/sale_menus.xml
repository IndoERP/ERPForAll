  <record id="menu_sale_config" model="ir.ui.menu"><field name="web_icon">lucide:sliders-horizontal</field></record>
  <record id="menu_sale_settings" model="ir.ui.menu"><field name="web_icon">lucide:settings</field></record>
  <record id="sales_team_config" model="ir.ui.menu"><field name="web_icon">lucide:users</field></record>
  <record id="menu_sale_order_template" model="ir.ui.menu"><field name="web_icon">lucide:file-spreadsheet</field></record>
