<!--
The Sales application menu. The root ships inactive: the application addon
sale_management switches it on.
-->
<erp>
  <menuitem id="sale_menu_root" name="Sales" active="False" groups="sales_team.group_sale_salesman" sequence="30" web_icon="lucide:handshake">
    <menuitem id="sale_order_menu" name="Orders" sequence="10">
      <menuitem id="menu_sale_quotations" name="Quotations" action="action_quotations" sequence="10"/>
      <menuitem id="menu_sale_order" name="Orders" action="action_orders" sequence="20"/>
      <menuitem id="menu_sale_teams_dashboard" name="Sales Teams" action="action_sale_teams_dashboard" sequence="30"/>
      <menuitem id="res_partner_menu" name="Customers" action="action_customers" sequence="40"/>
    </menuitem>
    <menuitem id="product_menu_catalog" name="Products" groups="sales_team.group_sale_salesman" sequence="30">
      <menuitem id="menu_product_template_action" name="Products" action="product.product_template_action" sequence="10"/>
      <menuitem id="menu_product_product_action" name="Product Variants" action="product.product_product_action" sequence="20"/>
      <menuitem id="menu_product_pricelist_main" name="Pricelists" action="product.product_pricelist_action2" sequence="30"/>
      <menuitem id="menu_loyalty_program" name="Discounts &amp; Loyalty" action="action_loyalty_program" sequence="40"/>
    </menuitem>
    <menuitem id="menu_sale_report" name="Reporting" groups="sales_team.group_sale_salesman" sequence="40">
      <menuitem id="menu_sale_dynamic_report" groups="sales_team.group_sale_salesman" name="Sales Report" action="action_sale_dynamic_report" sequence="10"/>
      <menuitem id="menu_sale_by_product_report" groups="sales_team.group_sale_salesman" name="Sales by Product" action="action_sale_by_product_report" sequence="15"/>
      <menuitem id="menu_sale_analysis" groups="sales_team.group_sale_salesman" name="Sales Pivot &amp; Graph" action="action_sale_order_analysis" sequence="20"/>
    </menuitem>
    <menuitem id="menu_sale_config" name="Configuration" groups="sales_team.group_sale_manager" sequence="90">
      <menuitem id="menu_sale_settings" name="Settings" action="sale_settings_action" groups="base.group_system" sequence="5"/>
      <menuitem id="sales_team_config" name="Sales Teams" action="sales_team.crm_team_action_config" sequence="10"/>
      <menuitem id="menu_sale_order_template" name="Quotation Templates" action="action_sale_order_template" sequence="15"/>
    </menuitem>
  </menuitem>

  <record id="sale_order_menu" model="ir.ui.menu"><field name="web_icon">lucide:clipboard-list</field></record>
  <record id="menu_sale_quotations" model="ir.ui.menu"><field name="web_icon">lucide:file-text</field></record>
  <record id="menu_sale_order" model="ir.ui.menu"><field name="web_icon">lucide:clipboard-list</field></record>
  <record id="menu_sale_teams_dashboard" model="ir.ui.menu"><field name="web_icon">lucide:users</field></record>
  <record id="res_partner_menu" model="ir.ui.menu"><field name="web_icon">lucide:contact</field></record>
  <record id="product_menu_catalog" model="ir.ui.menu"><field name="web_icon">lucide:package</field></record>
  <record id="menu_product_template_action" model="ir.ui.menu"><field name="web_icon">lucide:package</field></record>
  <record id="menu_product_product_action" model="ir.ui.menu"><field name="web_icon">lucide:boxes</field></record>
  <record id="menu_product_pricelist_main" model="ir.ui.menu"><field name="web_icon">lucide:tag</field></record>
  <record id="menu_loyalty_program" model="ir.ui.menu"><field name="web_icon">lucide:tags</field></record>
  <record id="menu_sale_report" model="ir.ui.menu"><field name="web_icon">lucide:bar-chart-3</field></record>
