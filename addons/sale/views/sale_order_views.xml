<!-- Quotations and sales orders: search, the two lists, the form, the line list and line form, and
     the two actions (fields and buttons of sale/views/sale_order_views.xml, laid out anew). Lines
     show in the line model's default list and open in its form as a dialog. -->
<erp>
  <record id="sale_order_line_view_list" model="ir.ui.view">
    <field name="name">sale.order.line.list</field>
    <field name="model">sale.order.line</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <list>
        <!--
The total with taxes and
             the delivered and invoiced quantities are on the line form; the list keeps what is read on the order, in
             the order of the lines' sequence (not a column). 
        -->
        <field name="sequence" invisible="1"/>
        <field name="display_type" invisible="1"/>
        <!-- the line form and the server keep a delivered or invoiced line's product and unit -->
        <field name="product_id"/>
        <field name="name" required="0"/>
        <field name="product_uom_qty"/>
        <field name="product_uom_id"/>
        <field name="price_unit"/>
        <field name="discount" string="Disc. %"/>
        <field name="tax_ids" widget="many2many_tags"/>
        <field name="currency_id" invisible="1"/>
        <field name="price_subtotal"/>
        <field name="price_total" invisible="1"/>
        <field name="qty_delivered" invisible="1"/>
        <field name="qty_invoiced" invisible="1"/>
      </list>
    </field>
  </record>

  <record id="sale_order_line_view_form" model="ir.ui.view">
    <field name="name">sale.order.line.form</field>
    <field name="model">sale.order.line</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <form string="Order Line">
        <sheet>
          <group>
            <group>
              <field name="display_type"/>
              <field name="product_id" invisible="display_type" readonly="qty_delivered &gt; 0 or qty_invoiced &gt; 0"/>
              <field name="name" required="0"/>
              <field name="analytic_account_id" invisible="display_type" groups="account.group_cost_center_controlling"/>
            </group>
            <group>
              <field name="product_uom_qty" invisible="display_type"/>
              <field name="product_uom_id" invisible="display_type" readonly="qty_delivered &gt; 0 or qty_invoiced &gt; 0"/>
              <field name="price_unit" invisible="display_type"/>
              <field name="technical_price_unit" invisible="1"/>
              <field name="discount" invisible="display_type"/>
              <field name="tax_ids" widget="many2many_tags" domain="[('type_tax_use', '=', 'sale')]" invisible="display_type"/>
            </group>
          </group>
          <group>
            <group>
              <field name="currency_id" invisible="1"/>
              <field name="price_subtotal" invisible="display_type"/>
              <field name="price_tax" invisible="display_type"/>
              <field name="price_total" invisible="display_type"/>
              <field name="purchase_price" invisible="display_type" groups="sales_team.group_sale_salesman"/>
              <field name="margin" invisible="display_type" groups="sales_team.group_sale_salesman"/>
              <field name="margin_percent" invisible="display_type" groups="sales_team.group_sale_salesman"/>
            </group>
            <group>
              <field name="customer_lead" invisible="display_type"/>
              <field name="qty_delivered_method" invisible="1"/>
              <field name="qty_delivered" invisible="display_type" readonly="qty_delivered_method != 'manual'"/>
              <field name="qty_invoiced" invisible="display_type"/>
              <field name="invoice_status" invisible="display_type"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_sales_order_filter" model="ir.ui.view">
    <field name="name">sale.order.search</field>
    <field name="model">sale.order</field>
    <field name="arch" type="xml">
      <search string="Sales Orders">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="user_id"/>
        <field name="team_id"/>
        <field name="client_order_ref"/>
        <field name="order_line" string="Product" filter_domain="[('order_line.product_id', 'ilike', self)]"/>
        <filter name="my_quotation" string="My Quotations" domain="[('user_id', '=', uid)]"/>
        <separator/>
        <filter name="draft" string="Quotations" domain="[('state', 'in', ('draft', 'sent'))]"/>
        <filter name="sales" string="Sales Orders" domain="[('state', '=', 'sale')]"/>
        <separator/>
        <filter name="to_invoice" string="To Invoice" domain="[('invoice_status', '=', 'to invoice')]"/>
        <filter name="upselling" string="To Upsell" domain="[('invoice_status', '=', 'upselling')]"/>
        <group>
          <filter name="customer" string="Customer" context="{'group_by': 'partner_id'}"/>
          <filter name="salesperson" string="Salesperson" context="{'group_by': 'user_id'}"/>
          <filter name="sales_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
          <filter name="status" string="Status" context="{'group_by': 'state'}"/>
          <filter name="order_month" string="Order Date" context="{'group_by': 'date_order'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_quotation_tree" model="ir.ui.view">
    <field name="name">sale.order.list.quotation</field>
    <field name="model">sale.order</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <list string="Quotations">
        <dashboard>
          <count name="quotations" string="Quotations" filter="draft" color="info"/>
          <count name="sales" string="Sales Orders" filter="sales" color="success"/>
          <count name="to_invoice" string="To Invoice" filter="to_invoice" color="warning"/>
        </dashboard>
        <field name="name" string="Number"/>
        <field name="date_order" string="Creation Date"/>
        <field name="partner_id"/>
        <field name="user_id" widget="many2one_avatar"/>
        <field name="team_id"/>
        <field name="company_id"/>
        <field name="currency_id" invisible="1"/>
        <field name="amount_untaxed"/>
        <field name="amount_total"/>
        <field name="state" widget="badge" options="{'tone_success': ['sale'], 'tone_info': ['sent'], 'tone_warning': ['draft'], 'tone_danger': ['cancel']}"/>
      </list>
    </field>
  </record>

  <record id="view_order_tree" model="ir.ui.view">
    <field name="name">sale.order.list</field>
    <field name="model">sale.order</field>
    <field name="priority" eval="20"/>
    <field name="arch" type="xml">
      <list string="Sales Orders">
        <dashboard>
          <count name="quotations" string="Quotations" filter="draft" color="info"/>
          <count name="sales" string="Sales Orders" filter="sales" color="success"/>
          <count name="to_invoice" string="To Invoice" filter="to_invoice" color="warning"/>
        </dashboard>
        <field name="name" string="Number"/>
        <field name="date_order" string="Order Date"/>
        <field name="partner_id"/>
        <field name="user_id" widget="many2one_avatar"/>
        <field name="team_id"/>
        <field name="company_id"/>
        <field name="currency_id" invisible="1"/>
        <field name="amount_untaxed"/>
        <field name="amount_total"/>
        <field name="state" widget="badge" options="{'tone_success': ['sale'], 'tone_info': ['sent'], 'tone_warning': ['draft'], 'tone_danger': ['cancel']}"/>
        <field name="delivery_status" widget="badge" options="{'tone_success': ['full'], 'tone_warning': ['pending', 'partial']}"/>
        <field name="invoice_status" widget="badge" options="{'tone_success': ['invoiced'], 'tone_info': ['upselling', 'to invoice'], 'tone_muted': ['no']}"/>
      </list>
    </field>
  </record>

  <record id="view_order_form" model="ir.ui.view">
    <field name="name">sale.order.form</field>
    <field name="model">sale.order</field>
    <field name="arch" type="xml">
      <form string="Sales Order">
        <header>
          <button name="action_confirm" type="object" string="Confirm" data-hotkey="q" class="btn-primary" invisible="state not in ('draft', 'sent')"/>
          <button name="action_open_send_wizard" type="object" string="Send by Email" data-hotkey="g" invisible="state not in ('draft', 'sent')"/>
          <button name="action_apply_template" type="object" string="Apply Template" invisible="state not in ('draft', 'sent') or locked or not sale_order_template_id"/>
          <button name="action_add_optional_products" type="object" string="Add Options" invisible="state not in ('draft', 'sent') or locked or not sale_order_option_ids"/>
          <button name="action_open_sign_wizard" type="object" string="Sign" invisible="state not in ('draft', 'sent') or locked"/>
          <button name="action_update_prices" type="object" string="Update Prices" invisible="state not in ('draft', 'sent') or locked or not pricelist_id"/>
          <button name="action_open_discount_wizard" type="object" string="Discount" invisible="state not in ('draft', 'sent') or locked"/>
          <button name="action_open_coupon_wizard" type="object" string="Coupon" invisible="state not in ('draft', 'sent') or locked"/>
          <button name="action_open_invoice_wizard" type="object" string="Create Invoice" class="btn-primary"
                  groups="account.group_account_user" invisible="state != 'sale' or invoicing_closed"/>
          <button name="action_lock" type="object" string="Lock" invisible="state != 'sale' or locked" groups="sales_team.group_sale_manager"/>
          <button name="action_unlock" type="object" string="Unlock" invisible="state != 'sale' or not locked" groups="sales_team.group_sale_manager"/>
          <button name="action_draft" type="object" string="Set to Quotation" invisible="state != 'cancel'"/>
          <button name="action_cancel" type="object" string="Cancel" data-hotkey="x" invisible="state == 'cancel' or locked or cancel_blocked"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,sent,sale" readonly="1"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_invoice" type="object" class="oe_stat_button" icon="lucide:receipt-text" invisible="invoice_count == 0">
              <field name="invoice_count" widget="statinfo" string="Invoices"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Locked" bg_color="bg-info" invisible="not locked"/>
          <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancel'"/>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group name="sale_header">
            <group name="partner_details">
              <field name="partner_id" readonly="state not in ('draft', 'sent')"/>
              <field name="partner_invoice_id" readonly="locked or state == 'cancel'"/>
              <field name="partner_shipping_id" readonly="locked or state == 'cancel'"/>
            </group>
            <group name="order_details">
              <field name="sale_order_template_id" readonly="state not in ('draft', 'sent')"/>
              <field name="validity_date" readonly="state not in ('draft', 'sent')"/>
              <field name="date_order" readonly="state not in ('draft', 'sent')"/>
              <field name="pricelist_id" readonly="state not in ('draft', 'sent')"/>
              <field name="currency_id" readonly="1"/>
              <field name="company_id" readonly="state not in ('draft', 'sent')"/>
              <field name="locked" invisible="1" readonly="1"/>
              <field name="cancel_blocked" invisible="1" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Order Lines" name="order_lines">
              <field name="order_line" context="{'inline_search_field': 'product_id'}" readonly="locked or state == 'cancel'"/>
              <group name="note_group">
                <group>
                  <field name="note" readonly="state == 'cancel'"/>
                </group>
                <group name="sale_total">
                  <field name="amount_untaxed"/>
                  <field name="amount_tax"/>
                  <field name="amount_total"/>
                  <field name="margin" readonly="1" groups="sales_team.group_sale_salesman"/>
                  <field name="margin_percent" readonly="1" groups="sales_team.group_sale_salesman"/>
                </group>
              </group>
            </page>
            <page string="Optional Products" name="optional_products">
              <field name="sale_order_option_ids" readonly="locked or state == 'cancel'"/>
            </page>
            <page string="Other Info" name="other_information">
              <group>
                <group name="sales_person" string="Sales">
                  <field name="user_id" readonly="locked or state == 'cancel'"/>
                  <field name="team_id" readonly="locked or state == 'cancel'"/>
                  <field name="client_order_ref" readonly="state == 'cancel'"/>
                  <field name="tag_ids" widget="many2many_tags" readonly="state == 'cancel'"/>
                  <field name="require_signature" readonly="state not in ('draft', 'sent')"/>
                  <field name="require_payment" readonly="state not in ('draft', 'sent')"/>
                </group>
                <group name="sale_info" string="Invoicing">
                  <field name="fiscal_position_id" readonly="state not in ('draft', 'sent')"/>
                  <field name="invoice_status"/>
                  <field name="invoicing_closed" readonly="1"/>
                </group>
                <group name="sale_shipping" string="Delivery">
                  <field name="commitment_date" readonly="locked or state == 'cancel'"/>
                  <field name="delivery_status"/>
                </group>
                <group name="sale_reporting" string="Customer Signature &amp; Tracking">
                  <field name="origin" readonly="state == 'cancel'"/>
                  <field name="signed_by" readonly="1"/>
                  <field name="signed_on" readonly="1"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_quotations" model="ir.actions.act_window">
    <field name="name">Quotations</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">list,kanban,calendar,form</field>
    <field name="view_id" ref="view_quotation_tree"/>
    <field name="search_view_id" ref="view_sales_order_filter"/>
  </record>
  <record id="action_quotations_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_quotations"/>
    <field name="view_id" ref="view_quotation_tree"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_quotations_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_quotations"/>
    <field name="view_id" ref="view_order_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="40"/>
  </record>

  <record id="action_orders" model="ir.actions.act_window">
    <field name="name">Sales Orders</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">list,kanban,calendar,form</field>
    <field name="view_id" ref="view_order_tree"/>
    <field name="search_view_id" ref="view_sales_order_filter"/>
  </record>
  <record id="action_orders_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_orders"/>
    <field name="view_id" ref="view_order_tree"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="action_orders_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="action_orders"/>
    <field name="view_id" ref="view_order_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="40"/>
  </record>

  <record id="action_customers" model="ir.actions.act_window">
    <field name="name">Customers</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="base.partner_list"/>
    <field name="search_view_id" ref="base.partner_search"/>
  </record>
  <record id="res_partner_form_sale_orders_button" model="ir.ui.view">
    <field name="name">res.partner.form.sale.orders.button</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="lucide:shopping-bag"
                groups="sales_team.group_sale_salesman" invisible="sale_order_count == 0">
          <field name="sale_order_count" widget="statinfo" string="Sales"/>
        </button>
      </xpath>
    </field>
  </record>

  <record id="product_template_form_sale_orders_button" model="ir.ui.view">
    <field name="name">product.template.form.sale.orders.button</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_sales" type="object" class="oe_stat_button" icon="lucide:trending-up"
                groups="sales_team.group_sale_salesman" invisible="sales_order_count == 0">
          <field name="sales_order_count" widget="statinfo" string="Sales"/>
        </button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page name="sales" string="Sales">
          <group>
            <group name="invoicing" string="Invoicing">
              <field name="invoice_policy"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</erp>
