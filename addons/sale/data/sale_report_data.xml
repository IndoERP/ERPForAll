<!-- Dynamic Sales Reports built on the shared `reporting.report` screen -->
<erp>
  <data noupdate="1">
    <record id="report_sales_ledger" model="reporting.report">
      <field name="name">Sales Report</field>
      <field name="provider">sale.sales_report</field>
      <field name="date_mode">range</field>
      <field name="date_default">this_year</field>
      <field name="comparison" eval="False"/>
      <field name="multi_company" eval="False"/>
      <field name="unfold_all" eval="True"/>
      <field name="hide_zero">optional</field>
      <field name="search_bar" eval="True"/>
      <field name="totals_below" eval="True"/>
    </record>
    <record id="sale_rep_col_date" model="reporting.report.column"><field name="report_id" ref="report_sales_ledger"/><field name="sequence">10</field><field name="name">Order Date</field><field name="label">date_order</field><field name="kind">date</field></record>
    <record id="sale_rep_col_status" model="reporting.report.column"><field name="report_id" ref="report_sales_ledger"/><field name="sequence">20</field><field name="name">Status</field><field name="label">status</field><field name="kind">text</field></record>
    <record id="sale_rep_col_qty" model="reporting.report.column"><field name="report_id" ref="report_sales_ledger"/><field name="sequence">30</field><field name="name">Quantity</field><field name="label">qty</field><field name="kind">decimal</field></record>
    <record id="sale_rep_col_untaxed" model="reporting.report.column"><field name="report_id" ref="report_sales_ledger"/><field name="sequence">40</field><field name="name">Untaxed</field><field name="label">untaxed</field><field name="kind">monetary</field></record>
    <record id="sale_rep_col_total" model="reporting.report.column"><field name="report_id" ref="report_sales_ledger"/><field name="sequence">50</field><field name="name">Total</field><field name="label">total</field><field name="kind">monetary</field></record>
    <record id="sale_rep_col_margin" model="reporting.report.column"><field name="report_id" ref="report_sales_ledger"/><field name="sequence">60</field><field name="name">Margin</field><field name="label">margin</field><field name="kind">monetary</field><field name="groups">sales_team.group_sale_salesman</field></record>
    <record id="sale_rep_col_margin_pct" model="reporting.report.column"><field name="report_id" ref="report_sales_ledger"/><field name="sequence">70</field><field name="name">Margin %</field><field name="label">margin_pct</field><field name="kind">percent</field><field name="groups">sales_team.group_sale_salesman</field></record>

    <record id="report_sales_by_product" model="reporting.report">
      <field name="name">Sales by Product</field>
      <field name="date_mode">range</field>
      <field name="date_default">this_year</field>
      <field name="comparison" eval="True"/>
      <field name="multi_company" eval="False"/>
      <field name="unfold_all" eval="True"/>
      <field name="hide_zero">optional</field>
      <field name="search_bar" eval="True"/>
      <field name="totals_below" eval="True"/>
    </record>
    <record id="sale_prod_col_qty" model="reporting.report.column"><field name="report_id" ref="report_sales_by_product"/><field name="sequence">10</field><field name="name">Quantity</field><field name="label">qty</field><field name="kind">decimal</field><field name="sortable" eval="True"/></record>
    <record id="sale_prod_col_untaxed" model="reporting.report.column"><field name="report_id" ref="report_sales_by_product"/><field name="sequence">20</field><field name="name">Untaxed</field><field name="label">untaxed</field><field name="kind">monetary</field><field name="sortable" eval="True"/></record>
    <record id="sale_prod_col_margin" model="reporting.report.column"><field name="report_id" ref="report_sales_by_product"/><field name="sequence">30</field><field name="name">Margin</field><field name="label">margin</field><field name="kind">monetary</field><field name="sortable" eval="True"/><field name="groups">sales_team.group_sale_salesman</field></record>
    <record id="sale_prod_col_margin_pct" model="reporting.report.column"><field name="report_id" ref="report_sales_by_product"/><field name="sequence">40</field><field name="name">Margin %</field><field name="label">margin_pct</field><field name="kind">percent</field><field name="sortable" eval="True"/><field name="groups">sales_team.group_sale_salesman</field></record>

    <record id="sale_prod_line_confirmed" model="reporting.report.line">
      <field name="report_id" ref="report_sales_by_product"/>
      <field name="sequence">10</field>
      <field name="name">Confirmed Sales</field>
      <field name="code">CONFIRMED</field>
      <field name="groupby">product_id,order_partner_id</field>
    </record>
    <record id="sale_prod_conf_qty" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_confirmed"/><field name="label">qty</field><field name="model">sale.order.line</field><field name="field">product_uom_qty</field><field name="date_field">create_date</field><field name="domain">[["state","=","sale"],["display_type","=",false],["is_downpayment","=",false]]</field></record>
    <record id="sale_prod_conf_unt" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_confirmed"/><field name="label">untaxed</field><field name="model">sale.order.line</field><field name="field">price_subtotal</field><field name="date_field">create_date</field><field name="domain">[["state","=","sale"],["display_type","=",false],["is_downpayment","=",false]]</field></record>
    <record id="sale_prod_conf_mar" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_confirmed"/><field name="label">margin</field><field name="model">sale.order.line</field><field name="field">margin</field><field name="date_field">create_date</field><field name="domain">[["state","=","sale"],["display_type","=",false],["is_downpayment","=",false]]</field></record>
    <record id="sale_prod_conf_mar_pct" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_confirmed"/><field name="label">margin_pct</field><field name="engine">formula</field><field name="formula">margin * 100 / untaxed</field><field name="zero_division">empty</field></record>

    <record id="sale_prod_line_quotations" model="reporting.report.line">
      <field name="report_id" ref="report_sales_by_product"/>
      <field name="sequence">20</field>
      <field name="name">Open Quotations</field>
      <field name="code">QUOTATIONS</field>
      <field name="groupby">product_id,order_partner_id</field>
    </record>
    <record id="sale_prod_quot_qty" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_quotations"/><field name="label">qty</field><field name="model">sale.order.line</field><field name="field">product_uom_qty</field><field name="date_field">create_date</field><field name="domain">[["state","in",["draft","sent"]],["display_type","=",false],["is_downpayment","=",false]]</field></record>
    <record id="sale_prod_quot_unt" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_quotations"/><field name="label">untaxed</field><field name="model">sale.order.line</field><field name="field">price_subtotal</field><field name="date_field">create_date</field><field name="domain">[["state","in",["draft","sent"]],["display_type","=",false],["is_downpayment","=",false]]</field></record>
    <record id="sale_prod_quot_mar" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_quotations"/><field name="label">margin</field><field name="model">sale.order.line</field><field name="field">margin</field><field name="date_field">create_date</field><field name="domain">[["state","in",["draft","sent"]],["display_type","=",false],["is_downpayment","=",false]]</field></record>
    <record id="sale_prod_quot_mar_pct" model="reporting.report.expression"><field name="line_id" ref="sale_prod_line_quotations"/><field name="label">margin_pct</field><field name="engine">formula</field><field name="formula">margin * 100 / untaxed</field><field name="zero_division">empty</field></record>
  </data>

  <record id="action_sale_dynamic_report" model="ir.actions.client">
    <field name="name">Sales Report</field>
    <field name="tag">reporting.report</field>
    <field name="params" eval="{'report': ref('report_sales_ledger')}"/>
  </record>
  <record id="action_sale_by_product_report" model="ir.actions.client">
    <field name="name">Sales by Product</field>
    <field name="tag">reporting.report</field>
    <field name="params" eval="{'report': ref('report_sales_by_product')}"/>
  </record>
</erp>
