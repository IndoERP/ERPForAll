<erp>
    <record id="mail_activity_view_list" model="ir.ui.view">
        <field name="name">mail.activity.list</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml"><list><field name="summary"/><field name="res_name"/><field name="activity_type_id"/><field name="user_id"/><field name="date_deadline"/><field name="state"/></list></field>
    </record>
    <record id="mail_activity_view_form" model="ir.ui.view">
        <field name="name">mail.activity.form</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml"><form><sheet><group><field name="summary"/><field name="res_name"/><field name="activity_type_id"/><field name="user_id"/><field name="date_deadline"/><field name="state"/></group><field name="note"/></sheet></form></field>
    </record>
    <record id="mail_activity_action_my" model="ir.actions.act_window">
        <field name="name">My Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="mail_activity_view_list"/>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
    <record id="mail_activity_action_my_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="mail_activity_action_my"/>
        <field name="view_id" ref="mail_activity_view_list"/>
        <field name="view_mode">list</field>
        <field name="sequence" eval="10"/>
    </record>
    <record id="mail_activity_action_my_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="mail_activity_action_my"/>
        <field name="view_id" ref="mail_activity_view_form"/>
        <field name="view_mode">form</field>
        <field name="sequence" eval="20"/>
    </record>
</erp>
