<?xml version="1.0" encoding="utf-8"?>
<erp>
  <record id="change_password_own_form" model="ir.ui.view">
    <field name="name">Change own password</field><field name="model">change.password.own</field>
    <field name="arch" type="xml"><form string="Change password" record_mode="record"><group><field name="new_password" widget="password" required="1"/><field name="confirm_password" widget="password" required="1"/></group><footer><button name="change_password" type="object" string="Change password" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field>
  </record>
  <record id="change_password_identity_form" model="ir.ui.view">
    <field name="name">Confirm your identity</field><field name="model">res.users.identitycheck</field>
    <field name="arch" type="xml"><form string="Confirm your identity" record_mode="record"><group><field name="password" widget="password" required="1"/></group><footer><button name="run_check" type="object" string="Confirm" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field>
  </record>
  <record id="change_password_wizard_view" model="ir.ui.view">
    <field name="name">Reset selected passwords</field><field name="model">change.password.wizard</field>
    <field name="arch" type="xml"><form string="Reset passwords" record_mode="record"><field name="user_ids"/><footer><button name="change_password_button" type="object" string="Reset passwords" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field>
  </record>
  <record id="change_password_wizard_user_list" model="ir.ui.view">
    <field name="name">Selected password reset users</field><field name="model">change.password.user</field>
    <field name="arch" type="xml"><list><field name="user_login" readonly="1"/><field name="new_passwd" widget="password"/></list></field>
  </record>
  <record id="change_password_wizard_user_form" model="ir.ui.view">
    <field name="name">Selected password reset user</field><field name="model">change.password.user</field>
    <field name="arch" type="xml"><form string="Reset password" record_mode="record"><group><field name="user_login" readonly="1"/><field name="new_passwd" widget="password"/></group></form></field>
  </record>
  <record id="change_password_wizard_action" model="ir.actions.act_window"><field name="name">Reset passwords</field><field name="res_model">change.password.wizard</field><field name="view_mode">form</field><field name="target">new</field><field name="view_id" ref="change_password_wizard_view"/></record>
</erp>
