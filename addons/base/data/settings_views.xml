    <field name="view_id" ref="settings_languages_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="settings_languages_action_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="settings_languages_action"/>
    <field name="view_id" ref="settings_languages_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>
  <menuitem id="settings_languages_menu" name="Languages" parent="settings_menu" action="settings_languages_action" groups="base.group_system" sequence="30"/>
  <record id="settings_groups_list" model="ir.ui.view">
    <field name="name">res.groups.settings.list</field>
    <field name="model">res.groups</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="share"/></list></field>
  </record>
  <record id="settings_groups_form" model="ir.ui.view">
    <field name="name">res.groups.settings.form</field>
    <field name="model">res.groups</field>
    <field name="arch" type="xml"><form record_mode="record"><field name="name"/><field name="share"/><field name="implied_ids"/></form></field>
  </record>
  <record id="settings_groups_action" model="ir.actions.act_window">
    <field name="name">Groups</field>
    <field name="res_model">res.groups</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="settings_groups_list"/>
  </record>
  <record id="settings_groups_action_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="settings_groups_action"/>
    <field name="view_id" ref="settings_groups_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>
  <record id="settings_groups_action_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="settings_groups_action"/>
    <field name="view_id" ref="settings_groups_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>
  <menuitem id="settings_groups_menu" name="Groups" parent="settings_menu" action="settings_groups_action" groups="base.group_system" sequence="30"/>
  <record id="settings_access_list" model="ir.ui.view">
    <field name="name">ir.access.settings.list</field>
    <field name="model">ir.access</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="active"/><field name="model_id"/><field name="group_id"/><field name="operation"/></list></field>
  </record>
  <record id="settings_access_form" model="ir.ui.view">
    <field name="name">ir.access.settings.form</field>
    <field name="model">ir.access</field>
    <field name="arch" type="xml"><form record_mode="record"><field name="name"/><field name="active"/><field name="model_id"/><field name="group_id"/><field name="operation"/><field name="domain"/></form></field>
  </record>
  <record id="settings_access_action" model="ir.actions.act_window">
    <field name="name">Access Rules</field>
    <field name="res_model">ir.access</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="settings_access_list"/>
  </record>
  <record id="settings_access_action_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="settings_access_action"/>
