<?xml version="1.0" encoding="utf-8"?>
<erp noupdate="1">
  <record id="group_user" model="res.groups">
    <field name="name">Internal User</field>
  </record>
  <record id="group_portal" model="res.groups">
    <field name="name">Portal</field>
    <field name="share" eval="True"/>
  </record>
  <record id="group_public" model="res.groups">
    <field name="name">Public</field>
    <field name="share" eval="True"/>
  </record>
  <record id="group_user_regular" model="res.groups">
    <field name="name">Regular User</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'), 0)]"/>
  </record>
  <record id="default_user_group" model="res.groups">
    <field name="name">Default User Groups</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user_regular'), 0)]"/>
  </record>
  <record id="group_erp_manager" model="res.groups">
    <field name="name">Access Administration</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'), 0)]"/>
  </record>
  <record id="group_system" model="res.groups">
    <field name="name">Settings Administration</field>
    <field name="implied_ids" eval="[(4, ref('base.group_erp_manager'), 0)]"/>
  </record>
</erp>
