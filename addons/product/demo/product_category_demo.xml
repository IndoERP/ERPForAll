    <field name="name">Furniture</field>
    <field name="parent_id" ref="product_category_goods"/>
  </record>
  <record id="product_category_demo_apparel" model="product.category">
    <field name="name">Apparel</field>
    <field name="parent_id" ref="product_category_goods"/>
  </record>
  <record id="product_category_demo_food" model="product.category">
