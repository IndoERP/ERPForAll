    <field name="name">Electronics</field>
    <field name="parent_id" ref="product_category_goods"/>
  </record>
  <record id="product_category_demo_consulting" model="product.category">
    <field name="name">Consulting</field>
    <field name="parent_id" ref="product_category_services"/>
  </record>
  <record id="product_category_demo_maintenance" model="product.category">
    <field name="name">Maintenance</field>
    <field name="parent_id" ref="product_category_services"/>
