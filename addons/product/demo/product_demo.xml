<?xml version="1.0" encoding="utf-8"?>
<!-- Demo catalog: goods and services in invented Indonesian-flavoured business terms. Templates with attribute lines get one variant per combination when the line is created; the combo items point at single-variant products by search because generated variants carry no external id. -->
<erp>
  <record id="product_demo_meja" model="product.template">
    <field name="name">Meja Kerja</field>
    <field name="type">consu</field>
    <field name="categ_id" ref="product_category_demo_furniture"/>
    <field name="uom_id" ref="uom.product_uom_unit"/>
    <field name="list_price">450</field>
    <field name="standard_price">300</field>
    <field name="default_code">MJ-001</field>
    <field name="description_sale">Meja kerja untuk kantor kecil.</field>
  </record>
  <record id="ptal_demo_meja_material" model="product.template.attribute.line">
    <field name="product_tmpl_id" ref="product_demo_meja"/>
    <field name="attribute_id" ref="pa_material"/>
    <field name="value_ids" eval="[(6, 0, [ref('pav_material_jati'), ref('pav_material_baja')])]"/>
  </record>
