<?xml version="1.0" encoding="utf-8"?>
<erp>
  <record id="product_template_tree_view" model="ir.ui.view">
    <field name="name">product.template.list</field>
    <field name="model">product.template</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="default_code"/>
        <field name="barcode"/>
        <field name="list_price"/>
        <field name="standard_price"/>
        <field name="categ_id"/>
        <field name="type"/>
        <field name="uom_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="product_template_form_view" model="ir.ui.view">
    <field name="name">product.template.form</field>
    <field name="model">product.template</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <header>
          <button name="action_archive" type="object" string="Archive"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_variants" type="object" class="oe_stat_button"
                    invisible="product_variant_count &lt;= 1">
              <field name="product_variant_count" widget="statinfo" string="Variants"/>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" placeholder="e.g. Cheese Burger"/></h1>
          </div>
          <notebook>
            <page string="General Information" name="general_information">
              <group>
                <group>
                  <field name="type"/>
                  <field name="is_storable"/>
                  <field name="categ_id"/>
                  <field name="barcode"/>
                  <field name="default_code"/>
                </group>
                <group>
                  <field name="list_price"/>
                  <field name="standard_price"/>
                  <field name="uom_id"/>
                  <field name="active"/>
                </group>
              </group>
            </page>
            <page string="Attributes &amp; Variants" name="variants">
              <field name="attribute_line_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_template_action" model="ir.actions.act_window">
    <field name="name">Products</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="product_template_tree_view"/>
  </record>

  <record id="product_template_action_tree" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_template_action"/>
    <field name="view_id" ref="product_template_tree_view"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>

  <record id="product_template_action_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_template_action"/>
    <field name="view_id" ref="product_template_form_view"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>
</erp>
