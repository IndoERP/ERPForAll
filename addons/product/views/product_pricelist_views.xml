<?xml version="1.0" encoding="utf-8"?>
<erp>
  <record id="product_pricelist_view_tree" model="ir.ui.view">
    <field name="name">product.pricelist.list</field>
    <field name="model">product.pricelist</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="currency_id"/>
        <field name="company_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="product_pricelist_view" model="ir.ui.view">
    <field name="name">product.pricelist.form</field>
    <field name="model">product.pricelist</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_title">
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="currency_id"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Price Rules" name="pricelist_rules">
              <field name="item_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Columns of the price rules sub-list on the pricelist form. -->
  <record id="product_pricelist_item_tree_view" model="ir.ui.view">
    <field name="name">product.pricelist.item.list</field>
    <field name="model">product.pricelist.item</field>
    <field name="arch" type="xml">
      <list>
        <field name="applied_on"/>
        <field name="categ_id"/>
        <field name="product_tmpl_id"/>
        <field name="product_id"/>
        <field name="min_quantity"/>
        <field name="compute_price"/>
        <field name="fixed_price"/>
        <field name="price_discount"/>
        <field name="date_start"/>
        <field name="date_end"/>
      </list>
    </field>
  </record>

  <record id="product_pricelist_item_form_view" model="ir.ui.view">
    <field name="name">product.pricelist.item.form</field>
    <field name="model">product.pricelist.item</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <group string="Applies to">
            <field name="applied_on"/>
            <field name="categ_id" invisible="applied_on != '2_product_category'"/>
            <field name="product_tmpl_id" invisible="applied_on != '1_product'"/>
            <field name="product_id" invisible="applied_on != '0_product_variant'"/>
            <field name="min_quantity"/>
            <field name="date_start"/>
            <field name="date_end"/>
          </group>
          <group string="Price">
            <field name="compute_price"/>
            <field name="base" invisible="compute_price == 'fixed'"/>
            <field name="base_pricelist_id" invisible="base != 'pricelist'"/>
            <field name="fixed_price" invisible="compute_price != 'fixed'"/>
            <field name="price_discount" invisible="compute_price == 'fixed'"/>
            <field name="price_surcharge" invisible="compute_price == 'fixed'"/>
            <field name="price_round" invisible="compute_price == 'fixed'"/>
          </group>
        </group>
      </form>
    </field>
  </record>

  <record id="product_pricelist_action2" model="ir.actions.act_window">
    <field name="name">Pricelists</field>
    <field name="res_model">product.pricelist</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="product_pricelist_view_tree"/>
  </record>

  <record id="product_pricelist_action_tree" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_pricelist_action2"/>
    <field name="view_id" ref="product_pricelist_view_tree"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>

  <record id="product_pricelist_action_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_pricelist_action2"/>
    <field name="view_id" ref="product_pricelist_view"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>
</erp>
