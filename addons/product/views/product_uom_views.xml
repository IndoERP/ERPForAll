<?xml version="1.0" encoding="utf-8"?>
<erp>
  <record id="product_uom_view_list" model="ir.ui.view">
    <field name="name">product.uom.list</field>
    <field name="model">product.uom</field>
    <field name="arch" type="xml">
      <list>
        <field name="product_id"/>
        <field name="uom_id"/>
        <field name="barcode"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>

  <record id="product_uom_view_form" model="ir.ui.view">
    <field name="name">product.uom.form</field>
    <field name="model">product.uom</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <field name="product_id"/>
        <field name="uom_id"/>
        <field name="barcode"/>
        <field name="company_id"/>
      </form>
    </field>
  </record>

  <record id="product_uom_action_view_list" model="ir.actions.act_window">
    <field name="name">Packaging Barcodes</field>
    <field name="res_model">product.uom</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="product_uom_view_list"/>
  </record>

  <record id="product_uom_action_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_uom_action_view_list"/>
    <field name="view_id" ref="product_uom_view_list"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>

  <record id="product_uom_action_form" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_uom_action_view_list"/>
    <field name="view_id" ref="product_uom_view_form"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>
</erp>
