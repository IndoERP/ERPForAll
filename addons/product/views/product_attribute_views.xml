<?xml version="1.0" encoding="utf-8"?>
<erp>
  <!-- Attributes and their values: the list and form an attribute link on a product opens. -->
  <record id="product_attribute_list_view" model="ir.ui.view">
    <field name="name">product.attribute.list</field>
    <field name="model">product.attribute</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="display_type"/>
        <field name="create_variant"/>
      </list>
    </field>
  </record>

  <record id="product_attribute_form_view" model="ir.ui.view">
    <field name="name">product.attribute.form</field>
    <field name="model">product.attribute</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="e.g. Color"/></h1>
          </div>
          <group>
            <field name="display_type"/>
            <field name="create_variant"/>
            <field name="number_related_products" readonly="1"/>
          </group>
          <notebook>
            <page string="Attribute Values">
              <field name="value_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_attribute_value_list_view" model="ir.ui.view">
    <field name="name">product.attribute.value.list</field>
    <field name="model">product.attribute.value</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="default_extra_price"/>
      </list>
    </field>
  </record>

  <record id="product_attribute_value_form_view" model="ir.ui.view">
    <field name="name">product.attribute.value.form</field>
    <field name="model">product.attribute.value</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="name"/>
          <field name="default_extra_price"/>
        </group>
      </form>
    </field>
  </record>

  <record id="product_attribute_action" model="ir.actions.act_window">
    <field name="name">Attributes</field>
    <field name="res_model">product.attribute</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="product_attribute_list_view"/>
  </record>

  <record id="product_attribute_action_list" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_attribute_action"/>
    <field name="view_id" ref="product_attribute_list_view"/>
    <field name="view_mode">list</field>
    <field name="sequence" eval="10"/>
  </record>

  <record id="product_attribute_action_form_view" model="ir.actions.act_window.view">
    <field name="act_window_id" ref="product_attribute_action"/>
    <field name="view_id" ref="product_attribute_form_view"/>
    <field name="view_mode">form</field>
    <field name="sequence" eval="20"/>
  </record>
</erp>
