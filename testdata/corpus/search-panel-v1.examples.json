  "compatibility_cases": [
    {
      "name": "old client / new server",
      "renderer": "web.list_sections_v1",
      "expected": "visible old-client refusal before nodes; explicit manual reload loads compatible bundle; no automatic loop"
    },
    {
      "name": "new client / old server",
      "renderer": "web.list",
      "expected": "legacy selection/unsupported admitted; no sections under old key"
    },
    {
      "name": "new client unknown panel version",
      "version": 2,
      "guard_initially_set": false,
      "expected": "one guarded read-metadata reload, no data effects"
    },
    {
      "name": "persistent mismatch",
      "version": 2,
      "guard_initially_set": true,
      "expected": "fixed terminal visible error; zero further automatic reloads"
    },
    {
      "name": "dirty/pending/uncertain state or unavailable storage",
      "expected": "visible manual recovery only; no draft discard or write retry"
    },
    {
      "name": "intervening compatible root does not re-arm",
      "transitions": [
        "dependent mismatch",
        "one guarded reload",
        "compatible root",
        "compatible unrelated/background description",
        "same dependent mismatch"
      ],
      "expected": "fixed visible terminal error; no second automatic reload for the browsing-tab session"
    }
