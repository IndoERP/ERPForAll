      "value": "secret.model",
      "expected": "Validation; relation/comodel mismatch"
    },
    {
      "name": "undeclared RHS variable",
      "path": "sections[1].domain.ast.nodes[2].name",
      "value": "unlisted_category",
      "expected": "Validation; undeclared category dependency"
    },
    {
      "name": "wrong grouping scope",
