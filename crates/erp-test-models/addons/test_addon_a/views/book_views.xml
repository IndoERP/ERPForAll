<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_book_tree" model="ir.ui.view">
        <field name="name">test_addon.book.tree</field>
        <field name="model">test_addon.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author"/>
                <field name="published_year"/>
            </list>
        </field>
    </record>
    <record id="view_book_form" model="ir.ui.view">
        <field name="name">test_addon.book.form</field>
        <field name="model">test_addon.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="published_year"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
